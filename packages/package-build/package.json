{
    "name": "@heroiclands/package-build",
    "version": "0.1.0",
    "description": "Shared toolchain for building and shipping a HeroicLands Foundry VTT package \u2014 manifest, localization, styles, bundle and deployment.",
    "license": "GPL-3.0-or-later",
    "type": "module",
    "main": "./index.mjs",
    "exports": {
        ".": "./index.mjs",
        "./lang": "./lang.mjs",
        "./text": "./text.mjs",
        "./package.json": "./package.json",
        "./manifest": "./manifest.mjs"
    },
    "files": [
        "README.md",
        "index.mjs",
        "lang.mjs",
        "manifest.mjs",
        "text.mjs"
    ],
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "foundry-vtt",
        "foundryvtt",
        "heroiclands",
        "sohl",
        "song-of-heroic-lands",
        "build"
    ],
    "homepage": "https://heroiclands.org",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HeroicLands/Song-of-Heroic-Lands-FoundryVTT.git",
        "directory": "packages/package-build"
    },
    "bugs": {
        "url": "https://github.com/HeroicLands/Song-of-Heroic-Lands-FoundryVTT/issues"
    }
}
