{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "allowJs": true,
        "checkJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "noEmitOnError": true,
        "rootDir": ".",
        "declarationDir": "types"
    },
    "include": ["index.mjs", "config.mjs", "engine/**/*.mjs", "sohl/**/*.mjs"]
}
