{
    "name": "sohl",
    "productName": "Song of Heroic Lands",
    "description": "No classes. No levels. Just the character you imagined, shaped by what actually happens to them. Combat that bites, wounds that linger, magic that differs by tradition, and Fate for the day you should have died. Your world, Thalorna, or HârnWorld. A game system for Foundry VTT.",
    "version": "0.8.2",
    "private": true,
    "author": {
        "name": "Tom Rodriguez",
        "email": "toasty@heroiclands.org",
        "url": "https://www.heroiclands.org/"
    },
    "heroicLands": {
        "discordInviteUrl": "https://discord.gg/EwMfkNd3az/",
        "knowledgeBaseUrl": "https://www.heroiclands.org/sohl/kb/",
        "apiDocsUrl": "https://www.heroiclands.org/sohl/api/"
    },
    "homepage": "https://www.heroiclands.org/",
    "license": "GPL-3.0-or-later AND CC-BY-SA-4.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/HeroicLands/Song-of-Heroic-Lands-FoundryVTT"
    },
    "bugs": "https://github.com/HeroicLands/Song-of-Heroic-Lands-FoundryVTT/issues",
    "engines": {
        "node": ">=24.0.0"
    },
    "workspaces": [
        "packages/*",
        "."
    ],
    "type": "module",
    "browser": "./sohl.js",
    "exports": {
        "import": "./sohl.js"
    },
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "clean": "node utils/clean.mjs",
        "distclean": "node utils/clean.mjs --distclean",
        "build": "npm ci && npm run build:noci",
        "build:local": "npm i && npm run build:noci",
        "build:noci": "run-s lint build:types build:prepare test:coverage test:purity build:code lint:bundle-globals",
        "build:prepare": "run-p build:css build:db build:system",
        "build:db": "run-s build:assets build:compiledb build:link-manifest",
        "build:types": "tsc -p tsconfig.json",
        "build:system": "node ./utils/build-system-json.mjs",
        "build:css": "sass --load-path=scss scss/sohl.scss build/stage/css/sohl.css",
        "build:code": "vite build --mode release",
        "build:sohl-types": "tsc -p tsconfig.sohl-types.json && rollup -c packages/sohl-types/rollup.config.mjs",
        "build:content-build-types": "tsc -p packages/content-build/tsconfig.dts.json",
        "check:sohl-types": "npm run build:sohl-types && tsc -p packages/sohl-types/test/tsconfig.json",
        "build:assets": "node utils/copy-assets.mjs",
        "build:icons": "node utils/build-icon-font.mjs",
        "build:icon-legend": "node utils/build-icon-legend.mjs",
        "build:kb-icons": "node utils/build-kb-icon-assets.mjs",
        "build:compiledb": "node ./packages/content-build/bin/content-build.mjs package compile",
        "build:unpackdb": "node ./packages/content-build/bin/content-build.mjs package unpack",
        "build:kb-content": "node utils/build-kb-content.mjs",
        "build:link-manifest": "node utils/build-link-manifest.mjs",
        "build:kb": "npm run build:kb-content && hugo --source kb --minify --cleanDestinationDir",
        "site:assemble": "node utils/build-site.mjs",
        "build:site": "run-s docs:prepare docs:html build:kb site:assemble",
        "build:pack-release": "node utils/pack-release.mjs",
        "push:dev": "node utils/push-stage.mjs dev",
        "push:qa": "node utils/push-stage.mjs qa",
        "push:prod": "node utils/push-stage.mjs prod",
        "push:test": "node utils/push-stage.mjs test",
        "push:local-dev": "npm run push:qa",
        "container:dev": "node utils/foundry-container.mjs dev",
        "container:qa": "node utils/foundry-container.mjs qa",
        "container:prod": "node utils/foundry-container.mjs prod",
        "container:test": "node utils/foundry-container.mjs test",
        "container:leg": "node utils/foundry-container.mjs leg",
        "deploy:local": "npm run deploy:qa",
        "deploy:qa": "run-s build push:qa",
        "deploy:dev": "run-s build push:dev",
        "deploy:prod": "run-s build push:prod",
        "deploy:release": "run-s build build:pack-release",
        "docs": "run-s docs:prepare docs:html docs:md",
        "docs:prepare": "run-s docs:catalog docs:expr-scopes",
        "docs:catalog": "node utils/build-type-catalog.mjs",
        "docs:html": "typedoc --options typedoc-html.json",
        "docs:md": "typedoc --options typedoc-markdown.json",
        "docs:coverage": "run-s docs:prepare docs:coverage:check",
        "docs:coverage:check": "node utils/docs-coverage.mjs",
        "docs:serve": "http-server build/docs-html -o -c-1",
        "predocs:watch": "run-s docs:prepare docs:html",
        "docs:watch": "run-p \"docs:html -- --watch\" docs:serve",
        "codeanddocs": "run-p build:code docs:html",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage --passWithNoTests",
        "test:purity": "vitest run -c vitest.purity.config.ts",
        "e2e:full:seed": "node utils/seed-test-world.mjs",
        "e2e:full:run": "node utils/e2e-run.mjs run",
        "e2e:full:openrun": "node utils/e2e-run.mjs open",
        "e2e:full": "run-s push:test e2e:full:seed e2e:full:run",
        "e2e:full:open": "run-s push:test e2e:full:seed e2e:full:openrun",
        "e2e:fast": "node utils/e2e-redeploy.mjs",
        "e2e:sweep": "node utils/e2e-sweep.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "run-s lint:todos lint:lang lint:lang-coverage lint:lang-hardcoded lint:docs-index lint:doc-links lint:ns-barrels lint:type-catalog lint:expr-scopes lint:labels lint:packs lint:content-aliases lint:rules-vtt lint:content-links lint:e2e-red lint:eslint lint:dts",
        "lint:eslint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "lint:todos": "node utils/check-todos.mjs",
        "lint:e2e-red": "node utils/check-e2e-red.mjs",
        "lint:lang": "node utils/check-lang.mjs",
        "lint:lang-coverage": "node utils/check-lang-coverage.mjs",
        "lint:lang-hardcoded": "node utils/check-lang-hardcoded.mjs",
        "lint:docs-index": "node utils/check-docs-index.mjs",
        "lint:doc-links": "node utils/check-doc-links.mjs",
        "lint:ns-barrels": "node utils/check-ns-barrels.mjs",
        "lint:type-catalog": "node utils/check-type-catalog.mjs",
        "lint:labels": "node utils/check-labels.mjs",
        "lint:packs": "node utils/check-pack-shortcodes.mjs",
        "lint:content-aliases": "node utils/check-content-aliases.mjs",
        "lint:rules-vtt": "node utils/check-rules-vtt.mjs",
        "lint:content-links": "node utils/check-content-links.mjs",
        "lint:dts": "node utils/check-dts.mjs",
        "lint:bundle-globals": "node utils/check-bundle-globals.mjs",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:check": "changeset check",
        "docs:expr-scopes": "node utils/build-expression-scopes-doc.mjs",
        "lint:expr-scopes": "node utils/build-expression-scopes-doc.mjs --check"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.26.9",
        "@changesets/cli": "^2.28.1",
        "@eslint/js": "^10.0.1",
        "@foundryvtt/foundryvtt-cli": "^3.0.4",
        "@octokit/rest": "^21.1.1",
        "@rollup/plugin-terser": "^0.4.4",
        "@types/file-saver": "^2.0.7",
        "@types/json-schema": "^7.0.15",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.28.0",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "@vitest/ui": "^4.1.10",
        "acorn": "^8.18.0",
        "archiver": "^7.0.1",
        "classic-level": "^3.0.0",
        "cypress": "^15.20.1",
        "dotenv": "^16.4.7",
        "eslint": "^10.8.1",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-jsdoc": "^64.2.1",
        "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#14aa149928c0fee81ce6da6a2301fa8b8721860d",
        "glob": "^11.0.1",
        "globals": "^17.11.0",
        "gray-matter": "^4.0.3",
        "handlebars": "^4.7.9",
        "http-server": "^14.1.1",
        "ix": "^7.0.0",
        "loglevel": "^1.9.2",
        "loglevel-plugin-prefix": "^0.8.4",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "rollup": "^4.62.4",
        "rollup-plugin-dts": "^6.5.1",
        "sass": "^1.102.0",
        "ssh2-sftp-client": "^12.1.1",
        "svg2ttf": "^6.1.0",
        "svgicons2svgfont": "^16.0.0",
        "svgo": "^4.0.2",
        "svgson": "^5.3.1",
        "ttf2woff2": "^8.0.1",
        "typedoc": "0.28.20",
        "typedoc-github-theme": "0.4.0",
        "typedoc-plugin-markdown": "4.12.0",
        "typescript": "^5.3.3",
        "unidecode": "^1.1.0",
        "vite": "^6.4.3",
        "vite-plugin-banner": "^0.8.0",
        "vitest": "^4.1.10",
        "yaml": "^2.9.0"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.3",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.9",
        "@lezer/highlight": "^1.2.3",
        "jsep": "^1.4.0"
    }
}
