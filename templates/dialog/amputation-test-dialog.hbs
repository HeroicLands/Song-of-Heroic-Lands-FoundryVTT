<form>
    <div class="card-content center">
        <p>
            A grievous edged wound to the <strong>{{locationName}}</strong> may
            sever it. Confirm the modifier for the Strength test.
        </p>
    </div>

    <div class="form-group" data-tooltip="Modifier applied to the amputation Strength test">
        <label>Amputation Test Modifier:</label>
        <input type="number" name="modifier" value="{{modifier}}" />
    </div>
</form>
