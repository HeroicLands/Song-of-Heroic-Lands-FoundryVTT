{{!--
    Automated-combat attack dialog. The attacker picks the Strike Mode (one of
    the modes able to reach the target), the Aim (the target body part), and an
    Additional Modifier; the Weapon Aspect is derived from the chosen strike
    mode rather than chosen here. The choices are echoed onto the attack chat
    card for transparency.

    `modeChoices` is keyed by the mode's index in the caller's mode list, and
    `defaultModeIdx` is that index for the pre-selected mode.
--}}
<form>
    <div class="form-group">
        <label>Strike Mode:</label>
        <select name="modeIdx">
            {{selectOptions modeChoices selected=defaultModeIdx}}
        </select>
    </div>

    <div class="form-group">
        <label>Aim:</label>
        <select name="aim">
            {{selectOptions aimChoices selected=defaultAim}}
        </select>
    </div>

    <div class="form-group">
        <label>Additional Modifier:</label>
        <input
            type="number"
            name="situationalModifier"
            value="{{situationalModifier}}"
        />
    </div>
</form>
