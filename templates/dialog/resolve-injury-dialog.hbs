<form>
    <div class="grid grid-2col">
        <div
            class="form-group"
            data-tooltip="Zone Number aimed at (1..{{maxZoneNumber}}); used only when the Location derives"
        >
            <label>Target ZN:</label>
            <input
                type="number"
                name="targetZoneNumber"
                value="{{targetZoneNumber}}"
                min="1"
                {{#if bodyLocationCode}}disabled{{/if}}
            />
        </div>

        <div
            class="form-group"
            data-tooltip="Zone Die rolled to scatter the hit from the Target ZN"
        >
            <label>Zone Die:</label>
            <input
                type="number"
                name="zoneDie"
                value="{{zoneDie}}"
                min="1"
                {{#if bodyLocationCode}}disabled{{/if}}
            />
        </div>
    </div>

    <div class="form-group">
        <label>Location:</label>
        <select name="bodyLocationCode">
            <option value="">(derive from Target ZN + ZD)</option>
            {{selectOptions hitLocations selected=bodyLocationCode
            valueAttr="code" labelAttr="name"}}
        </select>
    </div>

    <div class="grid grid-2col">
        <div class="form-group">
            <label>Aspect:</label>
            <select name="aspect">
                {{selectOptions aspectChoices selected=aspect localize=true}}
            </select>
        </div>

        <div class="form-group" data-tooltip="Impact damage value (before armor)">
            <label>Impact:</label>
            <input type="number" name="impact" value="{{impact}}" />
        </div>
    </div>

    <div class="grid grid-2col">
        <div
            class="form-group"
            data-tooltip="Reduces armor — applied only for a piercing aspect"
        >
            <label>Armor Reduction:</label>
            <input
                type="number"
                name="armorReduction"
                value="{{armorReduction}}"
            />
        </div>

        <div
            class="form-group"
            data-tooltip="Extra impact used only when deciding whether the wound bleeds"
        >
            <label>Bleed Impact Penalty:</label>
            <input
                type="number"
                name="bleedImpactPenalty"
                value="{{bleedImpactPenalty}}"
            />
        </div>
    </div>

    <div class="form-group" data-tooltip="Treatment modifier set on the resulting injury">
        <label>Treatment Modifier:</label>
        <input
            type="number"
            name="treatmentModifier"
            value="{{treatmentModifier}}"
        />
    </div>

    <div class="form-group">
        <input
            type="checkbox"
            name="autoAddInjury"
            value="{{autoAddInjury}}"
            data-dtype="Boolean"
            {{checked autoAddInjury}} />
        <label for="autoAddInjury">Add to Character Sheet</label>
    </div>
</form>
