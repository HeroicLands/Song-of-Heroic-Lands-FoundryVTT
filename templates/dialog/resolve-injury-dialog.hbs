<form>
    <div class="grid grid-2col">
        <div
            class="form-group"
            data-tooltip="{{localize "SOHL.Dialog.ResolveInjury.targetZnTip" max=maxZoneNumber}}"
        >
            <label>{{localize "SOHL.Dialog.ResolveInjury.targetZn"}}</label>
            <input
                type="number"
                name="targetZoneNumber"
                value="{{targetZoneNumber}}"
                min="1"
                {{#if bodyLocationCode}}disabled{{/if}}
            />
        </div>

        <div
            class="form-group"
            data-tooltip="{{localize "SOHL.Dialog.ResolveInjury.zoneDieTip"}}"
        >
            <label>{{localize "SOHL.Dialog.ResolveInjury.zoneDie"}}</label>
            <input
                type="number"
                name="zoneDie"
                value="{{zoneDie}}"
                min="1"
                {{#if bodyLocationCode}}disabled{{/if}}
            />
        </div>
    </div>

    <div class="form-group">
        <label>{{localize "SOHL.Dialog.ResolveInjury.location"}}</label>
        <select name="bodyLocationCode">
            <option value="">{{localize "SOHL.Dialog.ResolveInjury.deriveLocation"}}</option>
            {{selectOptions hitLocations selected=bodyLocationCode
            valueAttr="code" labelAttr="name"}}
        </select>
    </div>

    <div class="grid grid-2col">
        <div class="form-group">
            <label>{{localize "SOHL.Dialog.ResolveInjury.aspect"}}</label>
            <select name="aspect">
                {{selectOptions aspectChoices selected=aspect localize=true}}
            </select>
        </div>

        <div class="form-group" data-tooltip="{{localize "SOHL.Dialog.ResolveInjury.impactTip"}}">
            <label>{{localize "SOHL.Dialog.ResolveInjury.impact"}}</label>
            <input type="number" name="impact" value="{{impact}}" />
        </div>
    </div>

    <div class="grid grid-2col">
        <div
            class="form-group"
            data-tooltip="{{localize "SOHL.Dialog.ResolveInjury.armorReductionTip"}}"
        >
            <label>{{localize "SOHL.Dialog.ResolveInjury.armorReduction"}}</label>
            <input
                type="number"
                name="armorReduction"
                value="{{armorReduction}}"
            />
        </div>

        <div
            class="form-group"
            data-tooltip="{{localize "SOHL.Dialog.ResolveInjury.bleedPenaltyTip"}}"
        >
            <label>{{localize "SOHL.Dialog.ResolveInjury.bleedPenalty"}}</label>
            <input
                type="number"
                name="bleedImpactPenalty"
                value="{{bleedImpactPenalty}}"
            />
        </div>
    </div>

    <div class="form-group" data-tooltip="{{localize "SOHL.Dialog.ResolveInjury.treatmentModTip"}}">
        <label>{{localize "SOHL.Dialog.ResolveInjury.treatmentMod"}}</label>
        <input
            type="number"
            name="treatmentModifier"
            value="{{treatmentModifier}}"
        />
    </div>

    <div class="form-group">
        <input
            type="checkbox"
            name="autoAddInjury"
            value="{{autoAddInjury}}"
            data-dtype="Boolean"
            {{checked autoAddInjury}} />
        <label for="autoAddInjury">{{localize "SOHL.Dialog.ResolveInjury.addToSheet"}}</label>
    </div>
</form>
