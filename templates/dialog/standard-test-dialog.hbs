<form>
    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.target"}}</label>
        <input readonly type="number" name="target" value="{{mlMod.effective}}" />
    </div>

    {{#if mlMod}}
    <div class="form-group">
        {{{mlMod.chatHtml}}}
    </div>
    {{/if}}

    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.situationalModifier"}}</label>
        <input type="number" name="situationalModifier" value="{{situationalModifier}}" />
    </div>

    {{#if impactMod}}
    <div class="form-group">
        {{{mlMods.chatHtml}}}
    </div>

    <div class="form-group">
        <span class="label">{{localize "SOHL.Dialog.StandardTest.impactFormula"}}</span>
        <span class="value">{{impactMod.label}}</span>
    </div>

    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.additionalImpact"}}</label>
        <input type="number" name="impactSituationalModifier" value="{{impactSituationalModifier}}" />
    </div>
    {{/if}}

    {{#if aimChoices}}
    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.aim"}}</label>
        <select name="aim">
            {{selectOptions aimChoices selected=defaultAim}}
        </select>
    </div>        
    {{/if}}

    {{#if (or (eq testType "direct") (eq testType "volley"))}}
    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.targetMovement"}}</label>
        <select name="targetMovement">
            {{selectOptions movementOptions selected=targetMovement}}
        </select>
    </div>        
    {{/if}}
    
    {{#if (and askCXBothOption (eq testType "counterstrike"))}}
    <div class="form-group">
        <input type="checkbox" name="cxBothOption" {{checked cxBothOption}}>
        <label for="cxBothOption">{{localize "SOHL.Dialog.StandardTest.bothHitOnTies"}}</label>
    </div>        
    {{/if}}

    {{#if askBreakTies}}
    <div class="form-group">
        <input type="checkbox" name="breakTies" {{checked breakTies}}>
        <label for="breakTies">{{localize "SOHL.MasteryLevelModifier.successTest.breakTies"}}</label>
    </div>
    {{/if}}

    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.successLevelMod"}}</label>
        <input
            type="number"
            name="successLevelMod"
            value="{{mlMod.successLevelMod}}" />
    </div>
    <div class="form-group">
        <label>{{localize "SOHL.Dialog.StandardTest.rollVisibility"}}</label>
        <select aria-label="{{localize "SOHL.Dialog.StandardTest.rollVisibility"}}" class="roll-type-select" name="rollMode">
            {{selectOptions rollModes selected=rollMode localize=true}}
        </select>
    </div>
</form>
