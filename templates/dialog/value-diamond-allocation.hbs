<p>{{localize "SOHL.ValueDiamonds.prompt" earned=earned}}</p>
<div class="form-group"><label>{{localize "SOHL.ValueDiamonds.qualifiers"}}</label><input name="qualifiers" type="number" min="0" max="{{earned}}" step="1" value="{{qualifiers}}"></div>
