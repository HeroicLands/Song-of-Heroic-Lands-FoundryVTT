<form>
<div class="form-group"><label>{{localize "SOHL.Grab.manoeuvre"}}</label><select name="manoeuvre">{{#unless holdOnly}}<option value="take">{{localize "SOHL.Grab.take"}}</option>{{/unless}}{{#unless takeOnly}}<option value="hold">{{localize "SOHL.Grab.hold"}}</option>{{/unless}}</select></div>
<div class="form-group"><label>{{localize "SOHL.Grab.firstHand"}}</label><select name="firstHand" required>{{#each parts}}<option value="{{code}}">{{name}}</option>{{/each}}</select></div>
<div class="form-group"><label>{{localize "SOHL.Grab.secondHand"}}</label><select name="secondHand"><option value="">{{localize "SOHL.Common.none"}}</option>{{#each parts}}<option value="{{code}}">{{name}}</option>{{/each}}</select></div>
<div class="form-group"><label>{{localize "SOHL.Grab.targetPart"}}</label><select name="targetPart" required>{{#each targetParts}}<option value="{{code}}">{{name}}</option>{{/each}}</select></div>
<div class="form-group"><label>{{localize "SOHL.Grab.impactTA"}}</label><input type="number" name="impactTA" min="0" max="{{availableTA}}" step="1" value="0" /></div></form>
