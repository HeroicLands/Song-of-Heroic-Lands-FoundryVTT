<form>
    <div class="form-group">
        <label>{{localize "SOHL.Chat.ContagionCheck.affliction"}}:</label>
        <select name="affliction">
            {{selectOptions afflictions valueAttr="shortcode" labelAttr="name"}}
        </select>
    </div>

    <div class="grid grid-2col">
        <div class="form-group">
            <label>{{localize "SOHL.SuccessTestResult.situationalModifier"}}:</label>
            <input type="number" name="situationalModifier" value="0" />
        </div>

        <div class="form-group">
            <label>{{localize "SOHL.SuccessTestResult.successLevelMod"}}:</label>
            <input type="number" name="successLevelMod" value="0" />
        </div>
    </div>

    <div class="form-group">
        <label>
            <input type="checkbox" name="record" {{checked record}} />
            {{localize "SOHL.Chat.ContagionCheck.record"}}
        </label>
    </div>
</form>
