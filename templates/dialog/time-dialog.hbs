<form>
    <div class="form-group">
        <label>{{localize "SOHL.Dialog.Time.existing"}}</label>
        <span id="time">{{displayWorldTime setTime}}</span>
    </div>

    <div class="form-group">
        <label>{{localize "SOHL.Dialog.Time.timeBase"}}</label>
        <select name="timeBase">
            {{selectOptions timeBases selected=timeBase}}
        </select>
    </div>

    <div class="form-group">
        <label>{{localize "SOHL.Dialog.Time.direction"}}</label>
        <select name="direction">
            {{selectOptions timeDirections selected=direction}}
        </select>
    </div>

    <fieldset>
        <legend>{{localize "SOHL.Dialog.Time.setting"}}</legend>
        <div class="flexrow">
            <div>
                <label>{{localize "SOHL.Dialog.Time.days"}}</label>
                {{numberInput days name="days" step=1 min=0}}
            </div>
            <div>
                <label>{{localize "SOHL.Dialog.Time.hours"}}</label>
                {{numberInput hours name="hours" step=1 min=0}}
            </div>
            <div>
                <label>{{localize "SOHL.Dialog.Time.mins"}}</label>
                {{numberInput mins name="mins" step=1 min=0}}
            </div>
            <div>
                <label>{{localize "SOHL.Dialog.Time.secs"}}</label>
                {{numberInput secs name="secs" step=1 min=0}}
            </div>
        </div>
    </fieldset>
</form>
