<form>
    <div
        class="form-group"
        data-tooltip="{{localize "SOHL.Dialog.ShockTest.indexTip"}}">
        <label>{{localize "SOHL.Dialog.ShockTest.index"}}</label>
        <input type="number" name="shockIndex" value="{{shockIndex}}" />
    </div>
    <div class="form-group" data-tooltip="{{localize "SOHL.Dialog.ShockTest.targetTip"}}">
        <label>{{localize "SOHL.Dialog.ShockTest.target"}}</label>
        <input type="number" name="target" value="{{target}}" />
    </div>
    {{#if mods}}
    <div class="form-group">
        <div class="flex flex-2col">
            <div class="flexrow">
                <span class="label adj-name">{{localize "SOHL.Chat.Shock.adjustment"}}</span>
                <span class="label adj-value">{{localize "SOHL.Chat.Shock.value"}}</span>
            </div>
            {{#each mods}}
            <div class="flexrow">
                <span class="adj-name">{{this.name}}</span>
                <span class="adj-value"
                    >{{#if (gt this.value 0)}}+{{/if}}{{this.value}}</span
                >
            </div>
            {{/each}}
        </div>
    </div>
    {{/if}}
    <div
        class="form-group"
        data-tooltip="{{localize "SOHL.Dialog.ShockTest.targetModTip"}}">
        <label>{{localize "SOHL.Dialog.ShockTest.targetMod"}}</label>
        <input type="number" name="modifier" value="{{modifier}}" />
    </div>
    <div
        class="form-group"
        data-tooltip="{{localize "SOHL.Dialog.ShockTest.successLevelModTip"}}">
        <label>{{localize "SOHL.Dialog.ShockTest.successLevelMod"}}</label>
        <input
            type="number"
            name="successLevelMod"
            value="{{successLevelMod}}" />
    </div>
</form>
