<div class="body-zone-config__body">
<header class="body-zone-config__header">
    <h1 class="body-zone-config__name">
        <input type="text" name="name" value="{{zone.name}}" placeholder="{{localize "SOHL.BodyZone.FIELDS.name.label"}}" /></h1>
    <input class="body-zone-config__shortcode" type="text" name="shortcode" value="{{shortcode}}"
        placeholder="{{localize "SOHL.Common.shortcode"}}"
        data-tooltip="{{localize "SOHL.BodyZone.FIELDS.shortcode.hint"}}" />
</header>

<fieldset>
    <legend>{{localize "SOHL.BodyZone.Section.hitDetermination"}}</legend>
    <div class="grid grid-2col">
        <label class="form-group stacked"><span>{{localize "SOHL.BodyZone.FIELDS.zoneWeight.label"}}</span>
            <input type="number" step="1" min="0" name="probWeight" value="{{zone.probWeight}}"
                data-tooltip="{{localize "SOHL.BodyZone.FIELDS.zoneWeight.hint"}}" /></label>
        <div class="form-group stacked"><span>{{localize "SOHL.Being.BodyStructure.zoneNumberTip"}}</span>
            <p class="body-zone-config__range">{{#if zoneRange}}{{zoneRange}}{{else}}&mdash;{{/if}}</p></div>
    </div>
    <p class="hint">{{localize "SOHL.BodyZone.partCountHint" count=partCount}}</p>
</fieldset>
</div>
