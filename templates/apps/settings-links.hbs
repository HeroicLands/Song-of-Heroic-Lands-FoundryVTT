{{!-- Mirrors Foundry's native settings-sidebar Documentation block
      (section.documentation.flexcol + h4.divider + a.button) so it inherits
      the tab's own styling rather than looking bolted on. --}}
<section class="documentation flexcol" data-sohl-links>
    <h4 class="divider">{{title}}</h4>
    {{#each links}}
    <a class="button" href="{{this.url}}" rel="noopener nofollow" target="_blank">
        <i class="fa-solid {{this.icon}}" inert></i> {{this.label}}
    </a>
    {{/each}}
</section>
