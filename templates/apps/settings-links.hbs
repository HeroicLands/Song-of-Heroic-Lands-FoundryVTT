{{!-- Branded "Game System" section for the settings sidebar (issue #915),
      modelled on how dnd5e/SWADE present themselves there. Reuses Foundry's
      native section + h4.divider markup so the header inherits the tab's own
      styling; the emblem, version, and inline links are styled by
      scss/base/_settings-links.scss. --}}
<section class="flexcol sohl-game-system" data-sohl-links>
    <h4 class="divider">{{title}}</h4>
    <img class="sohl-game-system__emblem" src="{{emblem}}" alt="{{title}}" />
    <div class="sohl-game-system__version">{{version}}</div>
    <nav class="sohl-game-system__links">
        {{#each links}}
        {{#if this.action}}
        {{!-- An in-app command (Credits): a button, styled as its anchor
              siblings by _settings-links.scss. --}}
        <button type="button" data-action="{{this.action}}">{{this.label}}</button>
        {{else}}
        <a href="{{this.url}}" rel="noopener nofollow" target="_blank">{{this.label}}</a>
        {{/if}}
        {{/each}}
    </nav>
</section>
