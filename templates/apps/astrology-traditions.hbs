<section class="astrology-traditions">
    {{!-- Import / manage the world's astrology traditions --}}
    <fieldset>
        <legend>{{localize "SOHL.Astrology.Settings.import.label"}}</legend>
        <p class="hint">{{localize "SOHL.Astrology.Settings.import.hint"}}</p>
        <div class="form-group">
            <button type="button" data-action="importTraditions">
                <i class="fa-solid fa-file-import"></i>
                {{localize "SOHL.Astrology.Settings.import.button"}}
            </button>
            {{#if hasWorld}}
            <button type="button" data-action="clearTraditions">
                <i class="fa-solid fa-trash"></i>
                {{localize "SOHL.Astrology.Settings.clear.button"}}
            </button>
            {{/if}}
        </div>
    </fieldset>

    {{!-- The traditions currently available (built-in + world) --}}
    <fieldset>
        <legend>{{localize "SOHL.Astrology.Settings.list.label"}}</legend>
        {{#if hasTraditions}}
        <ul class="astrology-tradition-list">
            {{#each traditions}}
            <li class="astrology-tradition">
                <code class="tradition-key">{{this.key}}</code>
                <span class="tradition-label">{{this.label}}</span>
                <span class="tradition-sign-count">
                    {{this.signCount}}
                    {{localize "SOHL.Astrology.Settings.list.signs"}}
                </span>
                {{#if this.isWorld}}
                <span class="tradition-source tradition-source-world">
                    {{localize "SOHL.Astrology.Settings.list.world"}}
                </span>
                {{else}}
                <span class="tradition-source tradition-source-builtin">
                    {{localize "SOHL.Astrology.Settings.list.builtin"}}
                </span>
                {{/if}}
            </li>
            {{/each}}
        </ul>
        {{else}}
        <p class="hint">{{localize "SOHL.Astrology.Settings.list.none"}}</p>
        {{/if}}
    </fieldset>
</section>
