<div class="body-part-config__body">
<header class="body-part-config__header">
    <h1 class="body-part-config__name">
        <input type="text" name="name" value="{{part.name}}" placeholder="Body Part Name" /></h1>
    <input class="body-part-config__shortcode" type="text" name="shortcode" value="{{shortcode}}"
        placeholder="shortcode"
        data-tooltip="A short code identifying this body part. Must be unique among the being's body parts." />
</header>

<fieldset>
    <legend>Roles</legend>
    <label class="form-group stacked"><span>Functional Roles</span>
        <select name="roles" multiple size="4"
            data-tooltip="Which functional roles this part fulfills. Injury here impairs every skill or attribute that lists any of these roles.">
            {{#each roleOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select></label>
</fieldset>

<fieldset>
    <legend>General</legend>
    <div class="grid grid-2col">
        <label class="form-group stacked"><span>Weight</span>
            <input type="number" step="0.1" min="0" name="probWeight" value="{{part.probWeight}}"
                data-tooltip="Selection weight within this part's zone: once the zone is rolled, its parts are drawn in proportion to this weight. Also the area an aimed strike spends its accuracy against." /></label>
        <label class="form-group stacked"><span>Permanent Impairment</span>
            <input type="number" step="1" max="0" name="permanentImpairment" value="{{part.permanentImpairment}}"
                data-tooltip="A non-positive floor (0 = none) the derived impairment can never be milder than — e.g. an old maiming." /></label>
    </div>
</fieldset>

<fieldset>
    <legend>Flags</legend>
    <div class="grid grid-2col">
        <label class="form-group stacked checkbox"><span>Can Hold Item</span>
            <input type="checkbox" name="canHoldItem" {{#if part.canHoldItem}}checked{{/if}} /></label>
        <label class="form-group stacked checkbox"><span>Permanently Unusable</span>
            <input type="checkbox" name="permanentlyUnusable" {{#if part.permanentlyUnusable}}checked{{/if}}
                data-tooltip="Marks the part unusable regardless of tier (a withered or fully-amputated limb)." /></label>
    </div>
</fieldset>
</div>
