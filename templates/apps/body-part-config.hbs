<div class="body-part-config__body">
<header class="body-part-config__header">
    <h1 class="body-part-config__name">
        <input type="text" name="name" value="{{part.name}}" placeholder="{{localize "SOHL.BodyPart.FIELDS.name.label"}}" /></h1>
    <input class="body-part-config__shortcode" type="text" name="shortcode" value="{{shortcode}}"
        placeholder="{{localize "SOHL.Common.shortcode"}}"
        data-tooltip="{{localize "SOHL.BodyPart.FIELDS.shortcode.hint"}}" />
</header>

<fieldset>
    <legend>{{localize "SOHL.Common.parent"}}</legend>
    {{> shortcodeRefField embedded=true rootId="bodypart-zone" name="bodyZoneCode"
        value=part.bodyZoneCode options=bodyZoneCodeOptions
        label="SOHL.BodyPartConfig.zoneLabel" hint="SOHL.BodyPartConfig.zoneHint"}}
</fieldset>

<fieldset>
    <legend>{{localize "SOHL.BodyPart.Section.roles"}}</legend>
    <label class="form-group stacked"><span>{{localize "SOHL.BodyPart.FIELDS.roles.label"}}</span>
        <select name="roles" multiple size="4"
            data-tooltip="{{localize "SOHL.BodyPart.FIELDS.roles.hint"}}">
            {{#each roleOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
            {{/each}}
        </select></label>
</fieldset>

<fieldset>
    <legend>{{localize "SOHL.Common.general"}}</legend>
    <div class="grid grid-2col">
        <label class="form-group stacked"><span>{{localize "SOHL.BodyPart.FIELDS.weight.label"}}</span>
            <input type="number" step="0.1" min="0" name="probWeight" value="{{part.probWeight}}"
                data-tooltip="{{localize "SOHL.BodyPart.FIELDS.weight.hint"}}" /></label>
        <label class="form-group stacked"><span>{{localize "SOHL.BodyPart.FIELDS.impairmentBase.label"}}</span>
            <input type="number" step="1" max="0" name="permanentImpairment" value="{{part.permanentImpairment}}"
                data-tooltip="{{localize "SOHL.BodyPart.FIELDS.impairmentBase.hint"}}" /></label>
    </div>
</fieldset>

<fieldset>
    <legend>{{localize "SOHL.BodyPart.Section.flags"}}</legend>
    <div class="grid grid-2col">
        <label class="form-group stacked checkbox"><span>{{localize "SOHL.BodyPart.FIELDS.canHoldItem.label"}}</span>
            <input type="checkbox" name="canHoldItem" {{#if part.canHoldItem}}checked{{/if}} /></label>
        <label class="form-group stacked checkbox"><span>{{localize "SOHL.BodyPart.FIELDS.unusable.label"}}</span>
            <input type="checkbox" name="permanentlyUnusable" {{#if part.permanentlyUnusable}}checked{{/if}}
                data-tooltip="{{localize "SOHL.BodyPart.FIELDS.unusable.hint"}}" /></label>
    </div>
</fieldset>
</div>
