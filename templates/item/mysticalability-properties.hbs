<section class="tab properties{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="properties">
    <div class="field-grid field-grid--3col">
        {{formGroup fields.masteryLevelBase rootId="mystabl-mlb" classes="text-field" stacked=true value=system.masteryLevelBase}}
        {{formGroup fields.improveFlag rootId="mystabl-improve" classes="text-field" stacked=true value=system.improveFlag}}
        {{> shortcodeRefField embedded=embedded field=fields.assocSkillCode rootId="mystabl-assocskill" name="system.assocSkillCode" value=system.assocSkillCode options=assocSkillCodeOptions label="SOHL.MysticalAbility.FIELDS.assocSkillCode.label" hint="SOHL.MysticalAbility.FIELDS.assocSkillCode.hint" blankLabel=(localize "SOHL.Common.none")}}
        {{> shortcodeRefField embedded=embedded field=fields.assocAffiliationCode rootId="mystabl-assocaff" name="system.assocAffiliationCode" value=system.assocAffiliationCode options=assocAffiliationCodeOptions label="SOHL.MysticalAbility.FIELDS.assocAffiliationCode.label" hint="SOHL.MysticalAbility.FIELDS.assocAffiliationCode.hint" blankLabel=(localize "SOHL.Common.none")}}
        {{formGroup fields.levelBase rootId="mystabl-levelbase" classes="text-field" stacked=true value=system.levelBase}}
    </div>

    <fieldset>
        <legend>{{localize "SOHL.Mystery.Column.charges"}}</legend>
        <div class="field-grid field-grid--3col">
            {{formGroup fields.charges.fields.value rootId="mystabl-charges-val" classes="text-field" stacked=true value=system.charges.value}}
            {{formGroup fields.charges.fields.max rootId="mystabl-charges-max" classes="text-field" stacked=true value=system.charges.max}}
        </div>
    </fieldset>
</section>
