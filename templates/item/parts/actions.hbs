<section class="tab actions{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="actions">

    {{!-- Custom (script) actions — each bound to a Macro; GM-editable (#501) --}}
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-actions" value=""
            aria-label="Search Actions" placeholder="Search Actions" autocomplete="off" />
    </div>

    <div class="section-legend">
        <span class="section-legend__name">Custom Actions</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button action-create" data-action="createAction" data-tooltip="Create Action">
                <i class="fa-solid fa-file-plus"></i>
                <span>Create Action</span>
            </a>
        </span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1fr) 6rem 1fr 5rem">
        <div class="ledger__head">
            <div></div>
            <div>Action</div>
            <div>Group</div>
            <div>Notes</div>
            <div></div>
        </div>
        {{#each customActions as |action|}}
        <div class="ledger__row" data-search-name="{{localize action.data.title}}" data-action-name="{{action.data.shortcode}}">
            <div class="ledger__icon"><img src="{{action.data.img}}" alt="" /></div>
            <div class="ledger__name">{{localize action.data.title}}</div>
            <div class="ledger__cell ledger__cell--text">{{action.data.group}}</div>
            <div class="ledger__notes"></div>
            <div class="ledger__controls">
                <a class="icon-button" data-action="editAction" title="Edit Macro">
                    <i class="fa-solid fa-file-pen"></i>
                </a>
                <a class="icon-button icon-button--danger" data-action="deleteAction" title="Remove Action">
                    <i class="fa-solid fa-trash"></i>
                </a>
                <a class="icon-button" data-action="runAction" data-tooltip="Run {{localize action.data.title}}">
                    <i class="fa-solid fa-play"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- Intrinsic actions --}}
    <div class="section-legend">
        <span class="section-legend__name">Intrinsic Actions</span>
        <span class="section-legend__meta">read-only</span>
        <span class="section-legend__rule"></span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1fr) 6rem 1fr 2rem">
        <div class="ledger__head">
            <div></div>
            <div>Action</div>
            <div>Group</div>
            <div>Notes</div>
            <div></div>
        </div>
        {{#each intrinsicActions as |action|}}
        <div class="ledger__row" data-search-name="{{localize action.data.title}}" data-action-name="{{action.data.shortcode}}">
            <div class="ledger__icon"><img src="{{action.data.img}}" alt="" /></div>
            <div class="ledger__name">{{localize action.data.title}}</div>
            <div class="ledger__cell ledger__cell--text">{{action.data.group}}</div>
            <div class="ledger__notes"></div>
            <div class="ledger__controls">
                <a class="icon-button" data-action="runAction" data-tooltip="Run {{localize action.data.title}}">
                    <i class="fa-solid fa-play"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>
</section>
