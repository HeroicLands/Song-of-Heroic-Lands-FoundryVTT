<section class="tab actions{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="actions">

    {{!-- Custom (script) actions — each bound to a Macro; GM-editable (#501) --}}
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-actions" value=""
            aria-label="{{localize "SOHL.Actions.search"}}" placeholder="{{localize "SOHL.Actions.search"}}" autocomplete="off" />
    </div>

    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Actions.custom"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button action-create" data-action="createAction" data-tooltip="{{localize "SOHL.Actions.create"}}">
                <i class="fa-solid fa-file-plus"></i>
                <span>{{localize "SOHL.Actions.create"}}</span>
            </a>
        </span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1fr) 6rem 1fr 5rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.Actions.colAction"}}</div>
            <div>{{localize "SOHL.ContextMenu.SortGroup.label"}}</div>
            <div>{{localize "SOHL.Item.FIELDS.notes.label"}}</div>
            <div></div>
        </div>
        {{#each customActions as |action|}}
        <div class="ledger__row" data-search-name="{{localize action.data.title}}" data-action-name="{{action.data.shortcode}}">
            <div class="ledger__icon"><img src="{{action.data.img}}" alt="" /></div>
            <div class="ledger__name">{{localize action.data.title}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize (concat "SOHL.ContextMenu.SortGroup." action.data.group)}}</div>
            <div class="ledger__notes"></div>
            <div class="ledger__controls">
                <a class="icon-button" data-action="editAction" title="{{localize "SOHL.Actions.editMacro"}}">
                    <i class="fa-solid fa-file-pen"></i>
                </a>
                <a class="icon-button icon-button--danger" data-action="deleteAction" title="{{localize "SOHL.Actions.remove"}}">
                    <i class="fa-solid fa-trash"></i>
                </a>
                <a class="icon-button" data-action="runAction" data-tooltip="{{localize "SOHL.Actions.run" name=(localize action.data.title)}}">
                    <i class="fa-solid fa-play"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- Intrinsic actions --}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Actions.intrinsic"}}</span>
        <span class="section-legend__meta">{{localize "SOHL.Actions.readOnly"}}</span>
        <span class="section-legend__rule"></span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1fr) 6rem 1fr 2rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.Actions.colAction"}}</div>
            <div>{{localize "SOHL.ContextMenu.SortGroup.label"}}</div>
            <div>{{localize "SOHL.Item.FIELDS.notes.label"}}</div>
            <div></div>
        </div>
        {{#each intrinsicActions as |action|}}
        <div class="ledger__row" data-search-name="{{localize action.data.title}}" data-action-name="{{action.data.shortcode}}">
            <div class="ledger__icon"><img src="{{action.data.img}}" alt="" /></div>
            <div class="ledger__name">{{localize action.data.title}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize (concat "SOHL.ContextMenu.SortGroup." action.data.group)}}</div>
            <div class="ledger__notes"></div>
            <div class="ledger__controls">
                <a class="icon-button" data-action="runAction" data-tooltip="{{localize "SOHL.Actions.run" name=(localize action.data.title)}}">
                    <i class="fa-solid fa-play"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>
</section>
