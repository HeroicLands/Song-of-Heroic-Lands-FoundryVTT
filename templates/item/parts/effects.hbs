<section class="tab effects{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="effects">
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-effects" value=""
            aria-label="{{localize "SOHL.ActiveEffect.Search.label"}}" placeholder="{{localize "SOHL.ActiveEffect.Search.label"}}" autocomplete="off" />
    </div>

    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.ActiveEffect.Heading.own"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <button class="add-button effect-create" data-action="effectCreate" data-tooltip="{{localize "SOHL.ActiveEffect.Action.create"}}">
                <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.ActiveEffect.Action.create"}}</span>
            </button>
        </span>
    </div>
    <div class="ledger effects__list" style="--ledger-cols:1.5rem minmax(150px,1.3fr) 6.5rem 6rem 5.5rem 4rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.ActiveEffect.Column.effect"}}</div>
            <div>{{localize "SOHL.ActiveEffect.Column.target"}}</div>
            <div title="{{localize "SOHL.ActiveEffect.Column.remaining"}}">{{localize "SOHL.ActiveEffect.Column.remaining"}}</div>
            <div>{{localize "SOHL.ActiveEffect.Column.changes"}}</div>
            <div></div>
        </div>
        {{#each effects as |effect|}}
        <div class="ledger__row effects__row{{#if effect.disabled}} disabled{{/if}}"
            data-search-name="{{effect.name}}" data-effect-name="{{effect.name}}" data-effect-id="{{effect.id}}"
            data-effect-parent-uuid="{{effect.parent.uuid}}">
            <div class="ledger__icon"><img src="{{effect.img}}" alt="" /></div>
            <div class="ledger__name" data-tooltip="{{effect.name}}">{{effect.name}}</div>
            <div class="ledger__cell ledger__cell--text" data-tooltip="{{effect.system.targetLabel}}">{{effect.system.targetLabel}}</div>
            <div class="ledger__cell ledger__cell--text">{{#if effect.isTemporary}}{{effect.duration.label}}{{else}}{{localize "SOHL.ActiveEffect.indefinite"}}{{/if}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize "SOHL.ActiveEffect.changeCount" count=effect.system.changes.length}}</div>
            <div class="ledger__controls">
                <a class="icon-button{{#unless effect.disabled}} is-on{{/unless}} effect-toggle" data-action="effectToggle"
                    data-tooltip="{{#if effect.disabled}}{{localize "SOHL.ActiveEffect.Action.enable"}}{{else}}{{localize "SOHL.ActiveEffect.Action.disable"}}{{/if}}">
                    <i class="{{#if effect.disabled}}fas fa-toggle-off{{else}}fas fa-toggle-on{{/if}}"></i>
                </a>
                <a class="icon-button icon-button--danger effect-delete" data-action="effectDelete" data-tooltip="{{localize "SOHL.ActiveEffect.Action.delete"}}">
                    <i class="fa-solid fa-trash"></i>
                </a>
                <a class="icon-button effect-contextmenu" title="{{localize "SOHL.ActiveEffect.Action.menu"}}">
                    <i class="fa-solid fa-ellipsis-vertical fa-fw"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>

    {{!-- Transferred Effects (read-only) --}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.ActiveEffect.Heading.transferred"}}</span>
        <span class="section-legend__meta">{{localize "SOHL.ActiveEffect.Heading.readOnly"}}</span>
        <span class="section-legend__rule"></span>
    </div>
    <div class="ledger" style="--ledger-cols:1.5rem minmax(150px,1.3fr) 7rem 6rem 5.5rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.ActiveEffect.Column.effect"}}</div>
            <div>{{localize "SOHL.ActiveEffect.Column.source"}}</div>
            <div>{{localize "SOHL.ActiveEffect.Column.remaining"}}</div>
            <div>{{localize "SOHL.ActiveEffect.Column.changes"}}</div>
        </div>
        {{#each trxEffects as |effect|}}
        <div class="ledger__row effects__row{{#if effect.disabled}} disabled{{/if}}"
            data-search-name="{{effect.name}}" data-effect-name="{{effect.name}}" data-effect-id="{{effect.id}}">
            <div class="ledger__icon"><img src="{{effect.img}}" alt="" /></div>
            <div class="ledger__name" data-tooltip="{{effect.name}}">{{effect.name}}</div>
            <div class="ledger__cell ledger__cell--text" data-tooltip="{{effect.sourceName}}">{{effect.sourceName}}</div>
            <div class="ledger__cell ledger__cell--text">{{#if effect.isTemporary}}{{effect.duration.label}}{{else}}{{localize "SOHL.ActiveEffect.indefinite"}}{{/if}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize "SOHL.ActiveEffect.changeCount" count=effect.system.changes.length}}</div>
        </div>
        {{/each}}
    </div>
</section>
