<section class="tab properties{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="properties">
    <fieldset>
        <legend>{{localize "SOHL.Gear.Column.item"}}</legend>
        <div class="field-grid field-grid--3col">
            {{formGroup fields.quantity rootId="armgear-quant" classes="text-field" stacked=true value=system.quantity}}
            {{formGroup fields.weightBase rootId="armgear-wt" classes="text-field" stacked=true value=system.weightBase}}
            {{formGroup fields.valueBase rootId="armgear-val" classes="text-field" stacked=true value=system.valueBase}}
            {{formGroup fields.isCarried rootId="armgear-carried" classes="text-field" stacked=true value=system.isCarried}}
            {{!-- Worn is gated on carried (#1097): armor off the character's person cannot be worn. --}}
            {{formGroup fields.isWorn rootId="armgear-worn" classes="text-field" stacked=true value=system.isWorn disabled=(not system.isCarried)}}
            {{formGroup fields.qualityBase rootId="armgear-qual" classes="text-field" stacked=true value=system.qualityBase}}
            {{formGroup fields.durabilityBase rootId="armgear-dur" classes="text-field" stacked=true value=system.durabilityBase}}
            {{!-- Encumbrance (#1133): added to the wearer's encumbrance while
                  the armor is worn (BeingLogic.finalize, #1010). Disabled for an
                  article in a group, whose cost is charged to the set instead. --}}
            {{formGroup fields.encumbrance rootId="armgear-enc" classes="text-field" stacked=true value=system.encumbrance disabled=system.encumbranceGroup}}
            {{!-- Encumbrance group: the arm pieces cost nothing alone and 5
                  between them once three or more are worn. An article carries a
                  value or belongs to a group, never both. --}}
            {{formGroup fields.encumbranceGroup rootId="armgear-encgrp" classes="text-field" stacked=true value=system.encumbranceGroup}}
            {{!-- Perception penalty: applied to anything built on Perception
                  while worn; the worst worn penalty applies, never the sum. --}}
            {{formGroup fields.perceptionPenaltyBase rootId="armgear-perc" classes="text-field" stacked=true value=system.perceptionPenaltyBase}}
        </div>
        {{!-- Cohort sharing (#76): marks this item as shared with a cohort,
              which then lists it on its read-only Shared Gear tab. --}}
        {{> sharedWithCohortsField cohortChoices=cohortChoices sharedWithCohortIds=system.sharedWithCohortIds}}
    </fieldset>

    <div class="field-grid field-grid--3col">
        {{formGroup fields.material rootId="armgear-mat" classes="text-field" stacked=true value=system.material}}
    </div>

    {{!-- Protection (#1133): seeds ArmorGearLogic.protection, which is folded
          onto every covered body location and subtracted from an impact. --}}
    <fieldset>
        <legend>{{localize "SOHL.ArmorGear.FIELDS.protectionBase.label"}}</legend>
        <div class="field-grid field-grid--4col">
            {{formGroup fields.protectionBase.fields.blunt rootId="armgear-prot-blunt" classes="text-field" stacked=true value=system.protectionBase.blunt}}
            {{formGroup fields.protectionBase.fields.edged rootId="armgear-prot-edged" classes="text-field" stacked=true value=system.protectionBase.edged}}
            {{formGroup fields.protectionBase.fields.piercing rootId="armgear-prot-piercing" classes="text-field" stacked=true value=system.protectionBase.piercing}}
            {{formGroup fields.protectionBase.fields.fire rootId="armgear-prot-fire" classes="text-field" stacked=true value=system.protectionBase.fire}}
        </div>
    </fieldset>

    <fieldset>
        <legend>{{localize "SOHL.ArmorGear.Heading.bodyArmorLocations"}}</legend>
        <div class="array-list">
            {{#each locations.flexible}}
            <div class="array-list__row">
                <span class="array-list__field"><span class="chip chip--role armor-location">{{this}}</span></span>
                <a class="array-list__remove delete-array-item icon-button icon-button--danger"
                    data-action="deleteArrayItem"
                    data-array="system.locations.flexible"
                    data-unique="true"
                    data-value="{{this}}"
                    title="{{localize "SOHL.ArmorGear.Heading.flexibleLocation"}}"
                    ><i class="fa-solid fa-trash"></i></a>
            </div>
            {{else}}
            <div class="array-list__empty">—</div>
            {{/each}}
            <div class="array-list__add">
                <button type="button" class="add-button add-button--small add-array-item"
                    data-action="addArrayItem"
                    data-array="system.locations.flexible"
                    data-unique="true"
                    data-dtype="String"
                    data-default-value=""
                    data-title="{{localize "SOHL.ArmorGear.Heading.flexibleLocation"}}"
                    ><i class="fa-solid fa-plus"></i><span>{{localize "SOHL.ArmorGear.Action.addFlexible"}}</span></button>
            </div>
        </div>
        <div class="array-list">
            {{#each locations.rigid}}
            <div class="array-list__row">
                <span class="array-list__field"><span class="chip chip--role armor-location">{{this}}</span></span>
                <a class="array-list__remove delete-array-item icon-button icon-button--danger"
                    data-action="deleteArrayItem"
                    data-array="system.locations.rigid"
                    data-unique="true"
                    data-value="{{this}}"
                    title="{{localize "SOHL.ArmorGear.Heading.rigidLocation"}}"
                    ><i class="fa-solid fa-trash"></i></a>
            </div>
            {{else}}
            <div class="array-list__empty">—</div>
            {{/each}}
            <div class="array-list__add">
                <button type="button" class="add-button add-button--small add-array-item"
                    data-action="addArrayItem"
                    data-array="system.locations.rigid"
                    data-unique="true"
                    data-dtype="String"
                    data-default-value=""
                    data-title="{{localize "SOHL.ArmorGear.Heading.rigidLocation"}}"
                    ><i class="fa-solid fa-plus"></i><span>{{localize "SOHL.ArmorGear.Action.addRigid"}}</span></button>
            </div>
        </div>
    </fieldset>
</section>
