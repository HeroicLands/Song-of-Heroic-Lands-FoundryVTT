<section class="tab properties{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="properties">
    <div class="field-grid field-grid--3col">
        {{formGroup fields.scoreBase rootId="attribute-scorebase" classes="text-field" stacked=true value=system.scoreBase}}
        {{formGroup fields.initDiceFormula rootId="attribute-initdice" classes="text-field" stacked=true value=system.initDiceFormula}}
    </div>

    <div class="section-legend section-legend--subtype">
        <span class="section-legend__name">{{localize "SOHL.Attribute.Heading.valueDescriptors"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <button class="add-button add-button--small add-array-item" data-action="addArrayItem"
                data-array="system.valueDesc" data-object-type="ValueDesc" data-title="{{localize "SOHL.Attribute.Action.addValueDescTip"}}">
                <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Attribute.Action.addValueDesc"}}</span>
            </button>
        </span>
    </div>
    <div class="array-list" style="--array-cols: minmax(0,1fr) 5rem auto">
        <div class="array-list__head">
            <div>{{localize "SOHL.Attribute.Column.label"}}</div>
            <div>{{localize "SOHL.Attribute.Column.maxValue"}}</div>
            <div></div>
        </div>
        {{#each valueDesc}}
        <div class="array-list__row">
            <span class="array-list__field">{{this.label}}</span>
            <span class="array-list__value">{{this.maxValue}}</span>
            <a class="array-list__remove delete-array-item icon-button icon-button--danger"
                data-action="deleteArrayItem" data-array="system.valueDesc" data-index="{{@index}}"
                title="{{localize "SOHL.Attribute.Action.deleteValueDesc"}}"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{else}}
        <div class="array-list__empty">—</div>
        {{/each}}
    </div>

    <div class="section-legend section-legend--subtype">
        <span class="section-legend__name">{{localize "SOHL.Attribute.Heading.impairedByRoles"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <button class="add-button add-button--small add-array-item" data-action="addArrayItem"
                data-array="system.impairedByRoles" data-dtype="String" data-default-value=""
                data-title="{{localize "SOHL.Attribute.Action.addRoleTip"}}">
                <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Attribute.Action.addRole"}}</span>
            </button>
        </span>
    </div>
    <div class="array-list">
        {{#each impairedByRoles}}
        <div class="array-list__row">
            <span class="array-list__field">{{this}}</span>
            <a class="array-list__remove delete-array-item icon-button icon-button--danger"
                data-action="deleteArrayItem" data-array="system.impairedByRoles" data-value="{{this}}"
                title="{{localize "SOHL.Attribute.Action.deleteRole"}}"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{else}}
        <div class="array-list__empty">—</div>
        {{/each}}
    </div>
</section>
