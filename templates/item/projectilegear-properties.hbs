<section class="tab properties{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="properties">
    <fieldset>
        <legend>{{localize "SOHL.ProjectileGear.SECTION.gear"}}</legend>
        <div class="field-grid field-grid--3col">
            {{formGroup fields.quantity rootId="projgear-quant" classes="text-field" stacked=true value=system.quantity}}
            {{formGroup fields.weightBase rootId="projgear-wt" classes="text-field" stacked=true value=system.weightBase}}
            {{formGroup fields.valueBase rootId="projgear-val" classes="text-field" stacked=true value=system.valueBase}}
            {{formGroup fields.isCarried rootId="projgear-carried" classes="text-field" stacked=true value=system.isCarried}}
            {{formGroup fields.qualityBase rootId="projgear-qual" classes="text-field" stacked=true value=system.qualityBase}}
            {{formGroup fields.durabilityBase rootId="projgear-dur" classes="text-field" stacked=true value=system.durabilityBase}}
        </div>
        {{!-- Cohort sharing (#76): marks this item as shared with a cohort,
              which then lists it on its read-only Shared Gear tab. --}}
        {{> sharedWithCohortsField cohortChoices=cohortChoices sharedWithCohortIds=system.sharedWithCohortIds}}
    </fieldset>

    <div class="field-grid field-grid--3col">
        {{formGroup fields.shortName rootId="projgear-shortname" classes="text-field" stacked=true value=system.shortName}}
    </div>

    <fieldset>
        <legend>{{localize "SOHL.ProjectileGear.FIELDS.impactBase.label"}}</legend>
        <div class="field-grid field-grid--4col">
            {{formGroup fields.impactBase.fields.numDice rootId="projgear-imp-numdice" classes="text-field" stacked=true value=system.impactBase.numDice}}
            {{formGroup fields.impactBase.fields.die rootId="projgear-imp-die" classes="text-field" stacked=true value=system.impactBase.die}}
            {{formGroup fields.impactBase.fields.modifier rootId="projgear-imp-mod" classes="text-field" stacked=true value=system.impactBase.modifier}}
            {{formGroup fields.impactBase.fields.aspect rootId="projgear-imp-asp" classes="text-field" stacked=true localize=true value=system.impactBase.aspect}}
        </div>
    </fieldset>
</section>
