<section class="tab strikemodes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="strikemodes">
    <ol class="strikemodes__list">
        <li class="strikemodes__header flexrow">
            <h3 class="name">Strike Mode</h3>
            <div class="shortcode">Shortcode</div>
            <div class="type">Type</div>
            <div class="impact">Impact</div>
            <div class="strikemodes__controls">
                {{#if canAdd}}
                <a class="strikemodes__control strikemode-add" data-action="addStrikeMode"
                    data-tooltip="Add Strike Mode">
                    <i class="fa-solid fa-plus"></i>
                </a>
                {{/if}}
            </div>
        </li>
        <ol class="strikemodes__items">
            {{#each strikeModes as |sm|}}
            <li class="strikemodes__row flexrow" data-strikemode-key="{{sm.key}}">
                <div class="name"><h4 data-tooltip="{{sm.name}}">{{sm.name}}</h4></div>
                <div class="ele shortcode">{{sm.shortcode}}</div>
                <div class="ele type">{{sm.typeLabel}}</div>
                <div class="ele impact">{{sm.impactFormula}}</div>
                <div class="strikemodes__controls">
                    <a class="strikemodes__control strikemode-contextmenu" title="Menu">
                        <i class="fa-solid fa-ellipsis-vertical fa-fw"></i>
                    </a>
                </div>
            </li>
            {{/each}}
        </ol>
    </ol>

    {{#unless strikeModes.length}}
    <p class="notification info">No strike modes yet.{{#if canAdd}} Use the <i class="fa-solid fa-plus"></i>
        control above to add one.{{/if}}</p>
    {{/unless}}
</section>
