<section class="tab strikemodes{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="strikemodes">
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.StrikeMode.Heading.strikeModes"}}</span>
        <span class="section-legend__rule"></span>
        {{#if canAdd}}
        <span class="section-legend__add">
            <button type="button" class="add-button strikemode-add" data-action="addStrikeMode"
                data-tooltip="{{localize "SOHL.StrikeMode.Action.add"}}">
                <i class="fa-solid fa-plus"></i>
                <span>{{localize "SOHL.StrikeMode.Action.add"}}</span>
            </button>
        </span>
        {{/if}}
    </div>
    <div class="ledger" style="--ledger-cols:minmax(120px,1fr) 6rem 6rem 6rem 3rem">
        <div class="ledger__head">
            <div>{{localize "SOHL.StrikeMode.Column.strikeMode"}}</div>
            <div>{{localize "SOHL.StrikeMode.Column.shortcode"}}</div>
            <div>{{localize "SOHL.StrikeMode.Column.type"}}</div>
            <div>{{localize "SOHL.StrikeMode.Column.impact"}}</div>
            <div></div>
        </div>
        {{#each strikeModes as |sm|}}
        <div class="ledger__row strikemodes__row" data-strikemode-key="{{sm.key}}">
            <div class="ledger__name name" data-tooltip="{{sm.name}}"><h4>{{sm.name}}</h4></div>
            <div class="ledger__cell ledger__cell--text ele shortcode">{{sm.shortcode}}</div>
            <div class="ledger__cell ledger__cell--text ele type">{{sm.typeLabel}}</div>
            <div class="ledger__cell ele impact">{{sm.impactFormula}}</div>
            <div class="ledger__controls">
                <a class="icon-button strikemode-contextmenu" title="{{localize "SOHL.Common.menu"}}">
                    <i class="fa-solid fa-ellipsis-vertical fa-fw"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>

    {{#unless strikeModes.length}}
    <p class="notification info">{{localize "SOHL.StrikeMode.emptyState"}}{{#if canAdd}} {{localize "SOHL.StrikeMode.emptyUseThe"}} <i class="fa-solid fa-plus"></i>
        {{localize "SOHL.StrikeMode.emptyAddHint"}}{{/if}}</p>
    {{/unless}}
</section>
