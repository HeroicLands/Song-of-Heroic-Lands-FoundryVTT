<section class="tab properties{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="properties">
    <div class="grid grid-3col">
        {{formGroup fields.skillBaseFormula rootId="skill-sbf" classes="text-field" stacked=true value=system.skillBaseFormula}}
        {{formGroup fields.masteryLevelBase rootId="skill-mlb" classes="text-field" stacked=true value=system.masteryLevelBase}}
        {{formGroup fields.initSkillMult rootId="skill-initmult" classes="text-field" stacked=true value=system.initSkillMult}}
        {{formGroup fields.parentSkillCode rootId="skill-parent" classes="text-field" stacked=true value=system.parentSkillCode}}
        {{#if system.parentSkillCode}}
        {{formGroup fields.adoptParentMasteryLevel rootId="skill-adoptml" classes="text-field" stacked=true value=system.adoptParentMasteryLevel}}
        {{/if}}
        {{formGroup fields.improveFlag rootId="skill-improve" classes="text-field" stacked=true value=system.improveFlag}}
        {{#if (eq system.subType "combat")}}
        {{formGroup fields.combatCategory rootId="skill-combatcat" classes="text-field" stacked=true localize=true value=system.combatCategory}}
        {{/if}}
    </div>

    <div class="list-section">
        <div class="list">
            <header class="list__header flexrow">
                <h3 class="list__name name">Impaired By Roles</h3>
                <div class="list__controls">
                    <a class="list__control add-array-item" data-action="addArrayItem"
                        data-array="system.impairedByRoles" data-dtype="String" data-default-value=""
                        data-title="Impaired By Role"><i class="fa-solid fa-plus"></i> Add</a>
                </div>
            </header>
            <ol class="list">
                {{#each impairedByRoles}}
                <li class="item flexrow">
                    <div class="list__name name">{{this}}</div>
                    <div class="list__controls">
                        <a class="delete-array-item" data-action="deleteArrayItem"
                            data-array="system.impairedByRoles" data-value="{{this}}" title="Delete Role"><i
                                class="fa-solid fa-trash"></i></a>
                    </div>
                </li>
                {{else}}
                <li class="item flexrow">
                    <div class="list__name name">—</div>
                </li>
                {{/each}}
            </ol>
        </div>
    </div>

    {{!--
      A `combattechnique` skill's embedded strike mode is edited on the dedicated
      Strike Modes tab (shown only for that subtype) via the Strike Mode editor,
      not inline here — see templates/item/strikemodes.hbs and
      src/apps/foundry/StrikeModeConfig.ts.
    --}}
</section>
