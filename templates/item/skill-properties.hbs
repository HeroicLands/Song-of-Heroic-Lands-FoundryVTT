<section class="tab properties{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="properties">
    {{#if skillBaseError}}
    <p class="hint hint--error">{{localize "SOHL.Skill.sbInvalid" error=skillBaseError}}</p>
    {{/if}}
    <div class="field-grid field-grid--3col">
        {{> expressionField field=fields.skillBaseFormula rootId="skill-sbf" name="system.skillBaseFormula" value=system.skillBaseFormula}}
        {{formGroup fields.masteryLevelBase rootId="skill-mlb" classes="text-field" stacked=true value=system.masteryLevelBase}}
        {{formGroup fields.initSkillMult rootId="skill-initmult" classes="text-field" stacked=true value=system.initSkillMult}}
        {{> shortcodeRefField embedded=embedded field=fields.parentSkillCode rootId="skill-parent" name="system.parentSkillCode" value=system.parentSkillCode options=parentSkillCodeOptions label="SOHL.Skill.FIELDS.parentSkillCode.label" hint="SOHL.Skill.FIELDS.parentSkillCode.hint" blankLabel=(localize "SOHL.Common.none")}}
        {{#if system.parentSkillCode}}
        {{formGroup fields.adoptParentMasteryLevel rootId="skill-adoptml" classes="text-field" stacked=true value=system.adoptParentMasteryLevel}}
        {{/if}}
        {{formGroup fields.improveFlag rootId="skill-improve" classes="text-field" stacked=true value=system.improveFlag}}
        {{#if (eq system.subType "combat")}}
        {{formGroup fields.combatCategory rootId="skill-combatcat" classes="text-field" stacked=true localize=true value=system.combatCategory}}
        {{/if}}
    </div>

    <div class="section-legend section-legend--subtype">
        <span class="section-legend__name">{{localize "SOHL.Attribute.Heading.impairedByRoles"}}</span>
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <button class="add-button add-button--small add-array-item" data-action="addArrayItem"
                data-array="system.impairedByRoles" data-dtype="String" data-default-value=""
                data-title="{{localize "SOHL.Attribute.Action.addRoleTip"}}">
                <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Attribute.Action.addRole"}}</span>
            </button>
        </span>
    </div>
    <div class="array-list">
        {{#each impairedByRoles}}
        <div class="array-list__row">
            <span class="array-list__field">{{this}}</span>
            <a class="array-list__remove delete-array-item icon-button icon-button--danger"
                data-action="deleteArrayItem" data-array="system.impairedByRoles" data-value="{{this}}"
                title="{{localize "SOHL.Attribute.Action.deleteRole"}}"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{else}}
        <div class="array-list__empty">—</div>
        {{/each}}
    </div>

    {{!--
      A `combattechnique` skill's embedded strike mode is edited on the dedicated
      Strike Modes tab (shown only for that subtype) via the Strike Mode editor,
      not inline here — see templates/item/strikemodes.hbs and
      src/apps/foundry/StrikeModeConfig.ts.
    --}}
</section>
