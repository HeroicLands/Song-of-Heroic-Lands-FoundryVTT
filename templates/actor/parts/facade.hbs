<section class="tab facade{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="facade">
    <div class="facade__portrait">
        <img class="facade__image" src="{{portrait}}" data-edit="system.portrait"
            title="{{actorName}}" height="300" width="200" />
    </div>
    <div class="facade__appearance">
        <div class="facade__appearance-label">{{localize "SOHL.Actor.FIELDS.appearance.label"}}</div>
        <div class="facade__editor">
            <prose-mirror name="system.appearance" value="{{system.appearance}}" data-document-uuid="{{document.uuid}}"></prose-mirror>
        </div>
    </div>
</section>
