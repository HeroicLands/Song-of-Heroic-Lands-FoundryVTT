<section class="tab gear{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="gear">
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-gear" value=""
            aria-label="Search Gear" placeholder="Search Gear" autocomplete="off" />
    </div>

    {{!-- One gear section (On Body or a container): a section-legend banding
          the capacity/encumbrance readout, plus a ledger of the Type / Qty /
          Weight / Qual / Dur / Notes columns. `.gear-list` (search-filter
          content root + drop-container scope) and `data-container-id` stay on
          the outer wrapper exactly as before; each row keeps the bare `.item`
          class the sheet's `.gear-list .item` drag selector targets. --}}
    {{#*inline "gearSection"}}
    <div class="gear-list"{{#if id}} data-container-id="{{id}}"{{/if}}>
        <div class="section-legend">
            <span class="section-legend__name">{{title}}</span>
            <span class="section-legend__meta">{{~#if capacity.isEncumbrance~}}
                Carried: {{capacity.used}} lb &middot; Enc {{capacity.encumbrance}}
                {{~else~}}
                Capacity: {{capacity.used}}/{{capacity.max}}
                {{~/if~}}</span>
            <span class="section-legend__rule"></span>
            <span class="section-legend__add">
                <a class="item-create add-button" data-action="createItem" data-tooltip="Add Gear">
                    <i class="fa-solid fa-file-circle-plus"></i><span>Add Gear</span>
                </a>
            </span>
        </div>
        <div class="ledger" style="--ledger-cols:1.2rem 1.5rem minmax(130px,1.4fr) 5.4rem 2.6rem 3.4rem 2.8rem 2.6rem 1fr 4rem">
            <div class="ledger__head">
                <div></div>
                <div></div>
                <div>Item</div>
                <div class="ledger__head-num">Type</div>
                <div class="ledger__head-num" data-tooltip="Quantity">Qty</div>
                <div class="ledger__head-num">Weight</div>
                <div class="ledger__head-num" data-tooltip="Quality">Qual</div>
                <div class="ledger__head-num" data-tooltip="Durability">Dur</div>
                <div>Notes</div>
                <div></div>
            </div>
            {{#each items as |item|}}
            <div class="ledger__row item" data-search-name="{{item.name}}" data-item-id="{{item.id}}" data-uuid="{{item.uuid}}">
                <div class="ledger__grip"><i class="fa-solid fa-grip-vertical"></i></div>
                <div class="ledger__icon"><img src="{{item.img}}" alt="{{item.name}}" /></div>
                <div class="ledger__name" data-tooltip="{{item.name}}">{{item.name}}</div>
                <div class="ledger__cell ledger__cell--text-center">{{item.typeLabel}}</div>
                <div class="ledger__cell">{{item.quantity}}</div>
                <div class="ledger__cell" data-tooltip="{{item.weightDeltaLabel}}" data-tooltip-direction="UP">{{item.weight}}</div>
                <div class="ledger__cell" data-tooltip="{{item.qualityDeltaLabel}}" data-tooltip-direction="UP">{{item.quality}}</div>
                <div class="ledger__cell" data-tooltip="{{item.durabilityDeltaLabel}}" data-tooltip-direction="UP">{{item.durability}}</div>
                <div class="ledger__notes" data-tooltip="{{item.notes}}">{{item.notes}}</div>
                <div class="ledger__controls">
                    {{#if item.isArmor}}
                    {{!-- Worn is gated on carried (#1097): armor off the character's person cannot be worn. --}}
                    <a class="item-worn icon-button{{#if item.isWorn}} icon-button--on{{/if}}" data-action="toggleWorn" title="{{#if item.isCarried}}{{localize "SOHL.Gear.worn"}}{{else}}{{localize "SOHL.Gear.wornRequiresCarried"}}{{/if}}"{{#unless item.isCarried}} disabled aria-disabled="true"{{/unless}}>
                        <i class="fa-solid fa-shield-halved"></i>
                    </a>
                    {{/if}}
                    <a class="item-carried icon-button{{#if item.isCarried}} icon-button--on{{/if}}" data-action="toggleCarried" title="Carried">
                        <i class="ginf-knapsack"></i>
                    </a>
                    <a class="item-contextmenu icon-button" title="Menu">
                        <i class="fa-solid fa-ellipsis-vertical fa-fw"></i>
                    </a>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
    {{/inline}}

    {{!-- On Body (loose gear) --}}
    {{> gearSection title="On Body" items=onBody.items capacity=onBody.capacity}}

    {{!-- Each container as its own section --}}
    {{#each containers as |section|}}
    {{> gearSection title=section.name id=section.id items=section.items capacity=section.capacity}}
    {{/each}}
</section>
