{{!--
Dismissible "Experimental — schema not final" notice shown on fenced (experimental)
actor sheets (cohort / structure / vehicle). Rendered only when the render context
sets `isFenced` (see SohlActorSheetBase). The dismiss button hides the banner for
the current view via the `dismissFenceNotice` sheet action (issue #959).
--}}
{{#if isFenced}}
<aside class="fence-banner" role="note" aria-label="{{localize 'SOHL.Fence.banner.title'}}">
    <i class="fence-banner__icon fa-solid fa-flask" aria-hidden="true"></i>
    <div class="fence-banner__text">
        <strong class="fence-banner__title">{{localize "SOHL.Fence.banner.title"}}</strong>
        <span class="fence-banner__body">{{localize "SOHL.Fence.banner.body"}}</span>
    </div>
    <button type="button" class="fence-banner__dismiss" data-action="dismissFenceNotice"
        title="{{localize 'SOHL.Fence.banner.dismiss'}}" aria-label="{{localize 'SOHL.Fence.banner.dismiss'}}">
        <i class="fa-solid fa-xmark" aria-hidden="true"></i>
    </button>
</aside>
{{/if}}
