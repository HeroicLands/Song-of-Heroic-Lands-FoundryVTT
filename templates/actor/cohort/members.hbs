{{!-- The cohort's Members roster (#1151): one row per `system.members` entry,
      named from the actor its `shortcodeOrUuid` handle resolves to — a
      shortcode for a world/compendium actor, a UUID for a Token Actor. Each row
      carries the two controls that manage membership: the chess-king, which
      makes that member the leader (and, on the leader's own row, stands them
      down), and the trashcan, which removes them from the cohort. Both — and
      the "+ Add Member" control in the legend — dispatch the cohort's
      `toggleLeader` / `removeMember` / `addMember` intrinsic actions, so these
      controls and the Actions tab drive one implementation.

      A member whose actor no longer resolves still gets a row, named by its raw
      handle and greyed: a cohort must be able to see, and remove, a member it
      can no longer reach. --}}
<section class="tab members{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="members">
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Cohort.FIELDS.members.label"}}</span>
        {{#if leaderName}}
        <span class="section-legend__meta">{{localize "SOHL.Cohort.FIELDS.leaderCode.label"}}: {{leaderName}}</span>
        {{/if}}
        <span class="section-legend__rule"></span>
        <span class="section-legend__add">
            <a class="add-button" data-action="addCohortMember" data-tooltip="{{localize 'SOHL.Cohort.Members.add.title'}}">
                <i class="fa-solid fa-user-plus"></i><span>{{localize "SOHL.Cohort.Members.add.control"}}</span>
            </a>
        </span>
    </div>

    {{#if members.length}}
    <div class="ledger" style="--ledger-cols:1.5rem minmax(140px,1.6fr) minmax(90px,1fr) minmax(90px,1fr) 1.8rem 1.8rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.Cohort.Members.column.name"}}</div>
            <div>{{localize "SOHL.Cohort.Members.column.role"}}</div>
            <div>{{localize "SOHL.Cohort.Members.column.health"}}</div>
            <div></div>
            <div></div>
        </div>
        {{#each members as |member|}}
        <div class="ledger__row{{#unless member.isResolved}} ledger__row--disabled{{/unless}}" data-search-name="{{member.name}}"
            data-member-ref="{{member.ref}}" data-uuid="{{member.uuid}}">
            <div class="ledger__icon">
                {{#if member.img}}<img src="{{member.img}}" alt="{{member.name}}" />{{/if}}
            </div>
            {{!-- An unresolved member is named by its raw handle and flagged:
                  the roster must show what is missing, not quietly drop it. --}}
            <div class="ledger__name" data-tooltip="{{member.ref}}">{{member.name}}{{#unless
                member.isResolved}}<span class="member-missing"
                    data-tooltip="{{localize 'SOHL.Cohort.Members.notFound.tooltip'}}"><i
                        class="fa-solid fa-triangle-exclamation fa-fw warning-icon"></i><span
                        class="member-missing__label">{{localize
                        "SOHL.Cohort.Members.notFound.label"}}</span></span>{{/unless}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize member.roleLabel}}</div>
            {{!-- Health reads as both a number and a word: the percentage for
                  comparing members at a glance, the band for what it means. A
                  member whose actor did not resolve has neither. --}}
            <div
                class="ledger__cell ledger__cell--health{{#if member.healthBand}} ledger__cell--health--{{toLowerCase member.healthBand}}{{/if}}">
                {{#if member.healthBandLabel}}
                <span class="member-health__pct">{{member.healthPct}}%</span>
                <span class="member-health__band">{{localize member.healthBandLabel}}</span>
                {{/if}}
            </div>
            <div class="ledger__controls">
                <a class="icon-button{{#if member.isLeader}} is-on{{/if}}" data-action="setCohortLeader"
                    data-member-ref="{{member.ref}}"
                    data-tooltip="{{#if member.isLeader}}{{localize 'SOHL.Cohort.Members.leader.isLeader'}}{{else}}{{localize 'SOHL.Cohort.Members.leader.make'}}{{/if}}">
                    <i class="fa-solid fa-chess-king fa-fw"></i>
                </a>
            </div>
            <div class="ledger__controls">
                <a class="icon-button icon-button--danger" data-action="removeCohortMember"
                    data-member-ref="{{member.ref}}" data-tooltip="{{localize 'SOHL.Cohort.Members.remove.control'}}">
                    <i class="fa-solid fa-trash fa-fw"></i>
                </a>
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="notes">{{localize "SOHL.Cohort.Members.empty.roster"}}</p>
    {{/if}}
</section>
