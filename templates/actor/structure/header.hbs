<header class="sheet-header flexrow">
    <img class="sheet-header__portrait{{#if isDraft}} sohl-draft{{/if}}" src="{{actorImg}}" data-edit="img" alt="{{actorName}}" />
    <div class="sheet-header__details">
        <h1 class="actor-name">
            <input name="name" type="text" value="{{actorName}}" placeholder="{{localize 'Name'}}" />
        </h1>
        <input class="sheet-header__shortcode" name="system.shortcode" type="text"
            value="{{document.system.shortcode}}" placeholder="{{localize "SOHL.Common.shortcode"}}" />
        {{> archetypeField canMarkArchetype=canMarkArchetype templatePriority=templatePriority}}
        {{> draftField isDraft=isDraft}}
        <div class="item-subtitle">{{typeLabel}}</div>
        <div class="form-group">
            <label>{{localize "SOHL.Structure.FIELDS.workshopRating.label"}}</label>
            <input type="number" name="system.workshopRating" value="{{document.system.workshopRating}}" min="0" max="5" step="1" {{#unless isEditable}}disabled{{/unless}} />
            <span class="hint">{{localize "SOHL.Structure.FIELDS.workshopRating.hint"}}</span>
        </div>
        <div class="form-group">
            <label>{{localize "SOHL.Structure.FIELDS.maxHealth.label"}}</label>
            <input type="number" name="system.maxHealth" value="{{document.system.maxHealth}}" min="0" step="1" {{#unless isEditable}}disabled{{/unless}} />
            <span>{{structureHealth.value}} / {{structureHealth.max}}</span>
        </div>
        <div class="form-group">
            <label>{{localize "SOHL.Structure.FIELDS.occupantCapacity.label"}}</label>
            <input type="number" name="system.occupantCapacity" value="{{document.system.occupantCapacity}}" min="0" step="1" {{#unless isEditable}}disabled{{/unless}} />
            <span>{{structureOccupantCount}}</span>
            {{#if structureOccupantsOverCapacity}}<strong class="warning">{{localize "SOHL.Structure.capacityExceeded"}}</strong>{{/if}}
        </div>
        <div class="form-group">
            <label>{{localize "SOHL.Structure.FIELDS.cargoCapacity.label"}}</label>
            <input type="number" name="system.cargoCapacity" value="{{document.system.cargoCapacity}}" min="0" step="any" {{#unless isEditable}}disabled{{/unless}} />
            <span>{{structureCargoWeight}} {{localize "SOHL.Structure.weightUnit"}}</span>
            {{#if structureCargoOverCapacity}}<strong class="warning">{{localize "SOHL.Structure.capacityExceeded"}}</strong>{{/if}}
        </div>
    </div>
</header>
