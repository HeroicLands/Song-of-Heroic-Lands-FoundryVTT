{{!-- The vehicle's Occupants list (#201): one row per `system.occupants` entry,
      named from the actor its handle resolves to — a shortcode for a world or
      compendium actor, a UUID for a Token Actor. Each row shows the occupant's
      role aboard, an optional style ("Bosun"), and their current health, so a
      glance says who is aboard and how they are faring.

      Deliberately no leader control, unlike the cohort's roster: a vehicle's
      complement has roles but no single head the system tracks. A ship's master
      is a `title`, not a rank.

      An occupant whose actor no longer resolves still gets a row, named by its
      raw handle and flagged: a vehicle must be able to see, and remove, someone
      it can no longer reach. --}}
<section class="tab occupants{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="occupants">
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Vehicle.FIELDS.occupants.label"}}</span>
        <span class="section-legend__rule"></span>
        {{#if isEditable}}
        <span class="section-legend__add">
            <a class="add-button" data-action="addVehicleOccupant"
                data-tooltip="{{localize 'SOHL.Vehicle.Occupants.add.title'}}">
                <i class="fa-solid fa-user-plus"></i><span>{{localize "SOHL.Vehicle.Occupants.add.control"}}</span>
            </a>
        </span>
        {{/if}}
    </div>

    {{#if occupants.length}}
    <div class="ledger"
        style="--ledger-cols:1.5rem minmax(140px,1.6fr) minmax(90px,1fr) minmax(80px,1fr) minmax(90px,1fr) 1.8rem">
        <div class="ledger__head">
            <div></div>
            <div>{{localize "SOHL.Vehicle.Occupants.column.name"}}</div>
            <div>{{localize "SOHL.Vehicle.Occupants.column.role"}}</div>
            <div>{{localize "SOHL.Vehicle.Occupants.column.title"}}</div>
            <div>{{localize "SOHL.Vehicle.Occupants.column.health"}}</div>
            <div></div>
        </div>
        {{#each occupants as |occupant|}}
        <div class="ledger__row{{#unless occupant.isResolved}} ledger__row--disabled{{/unless}}"
            data-search-name="{{occupant.name}}" data-occupant-ref="{{occupant.ref}}" data-uuid="{{occupant.uuid}}">
            <div class="ledger__icon">
                {{#if occupant.img}}<img src="{{occupant.img}}" alt="{{occupant.name}}" />{{/if}}
            </div>
            <div class="ledger__name" data-tooltip="{{occupant.ref}}">{{occupant.name}}{{#unless
                occupant.isResolved}}<span class="member-missing"
                    data-tooltip="{{localize 'SOHL.Vehicle.Occupants.notFound.tooltip'}}"><i
                        class="fa-solid fa-triangle-exclamation fa-fw warning-icon"></i><span
                        class="member-missing__label">{{localize
                        "SOHL.Vehicle.Occupants.notFound.label"}}</span></span>{{/unless}}</div>
            <div class="ledger__cell ledger__cell--text">{{localize occupant.roleLabel}}</div>
            <div class="ledger__cell ledger__cell--text">{{occupant.title}}</div>
            <div
                class="ledger__cell ledger__cell--health{{#if occupant.healthBand}} ledger__cell--health--{{toLowerCase occupant.healthBand}}{{/if}}">
                {{#if occupant.healthBandLabel}}
                <span class="member-health__pct">{{occupant.healthPct}}%</span>
                <span class="member-health__band">{{localize occupant.healthBandLabel}}</span>
                {{/if}}
            </div>
            <div class="ledger__controls">
                {{!-- `@root` because `#each` rebinds the context to the row. --}}
                {{#if @root.isEditable}}
                <a class="icon-button icon-button--danger" data-action="removeVehicleOccupant"
                    data-occupant-ref="{{occupant.ref}}"
                    data-tooltip="{{localize 'SOHL.Vehicle.Occupants.remove.control'}}">
                    <i class="fa-solid fa-trash fa-fw"></i>
                </a>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
    {{else}}
    <p class="notes">{{localize "SOHL.Vehicle.Occupants.empty"}}</p>
    {{/if}}
</section>
