<section class="tab combat{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="combat">

    {{!-- Melee Strike Modes: combat techniques + held melee weapons, grouped
         per weapon under a small-caps SubType-style sub-header. One ledger,
         one column header, for the whole family. --}}
    {{#if meleeStrikeModes.length}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Being.Heading.meleeStrikeModes"}}</span>
    </div>
    <div class="ledger" style="--ledger-cols: minmax(120px,1fr) 2.3rem 2.3rem 2.6rem 3rem 2.4rem 2.4rem 2.4rem">
        <div class="ledger__head">
            <div>{{localize "SOHL.Being.Column.mode"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.heft"}}">{{localize "SOHL.Being.Column.heft"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.reach"}}">{{localize "SOHL.Being.Column.reach"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.zoneDice"}}">{{@root.spreadLabel}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.StrikeMode.FIELDS.impactBase.label"}}">{{localize "SOHL.Being.Column.impact"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.attack"}}">{{localize "SOHL.Being.Column.attack"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.block"}}">{{localize "SOHL.Being.Column.block"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.counterstrike"}}">{{localize "SOHL.Being.Column.counterstrike"}}</div>
        </div>
        {{#each meleeStrikeModes as |entry|}}
        <div class="section-legend section-legend--subtype">
            <span class="section-legend__name">{{entry.weapon.name}}</span>
        </div>
        {{#each entry.strikeModes as |sm|}}
        <div class="ledger__row" data-sm-id="{{sm.shortcode}}" data-item-id="{{entry.weapon.id}}">
            <div class="ledger__name" data-tooltip="{{sm.name}}">{{sm.name}}</div>
            <div class="ledger__cell" data-tooltip="{{sm.heft.deltaLabel}}" data-tooltip-direction="UP">{{sm.heft.effective}}</div>
            <div class="ledger__cell" data-tooltip="{{sm.reach.deltaLabel}}" data-tooltip-direction="UP">{{sm.reach.effective}}</div>
            <div class="ledger__cell" data-tooltip="{{sm.spread.deltaLabel}}" data-tooltip-direction="UP">d{{sm.spread.effective}}</div>
            {{#unless sm.impact.disabled}}
            <div class="ledger__cell ledger__cell--rollable" data-action="rollStrikeModeImpact" data-tooltip="{{sm.impact.deltaLabel}}" data-tooltip-direction="UP">
                {{sm.impact.label}}
            </div>
            {{else}}
            <div class="ledger__cell ledger__cell--dim"><i class="fa-solid fa-xmark fa-lg"></i></div>
            {{/unless}}
            {{#unless sm.attack.disabled}}
            <div class="ledger__cell ledger__cell--rollable" data-action="rollStrikeModeTest" data-test-kind="attack" data-tooltip="{{sm.attack.deltaLabel}}" data-tooltip-direction="UP">{{sm.attack.effective}}</div>
            {{else}}
            <div class="ledger__cell ledger__cell--dim"><i class="fa-solid fa-xmark fa-lg"></i></div>
            {{/unless}}
            {{#unless sm.defense.block.disabled}}
            <div class="ledger__cell ledger__cell--rollable" data-action="rollStrikeModeTest" data-test-kind="block" data-tooltip="{{sm.defense.block.deltaLabel}}" data-tooltip-direction="UP">{{sm.defense.block.effective}}</div>
            {{else}}
            <div class="ledger__cell ledger__cell--dim"><i class="fa-solid fa-xmark fa-lg"></i></div>
            {{/unless}}
            {{#unless sm.defense.counterstrike.disabled}}
            <div class="ledger__cell ledger__cell--rollable" data-action="rollStrikeModeTest" data-test-kind="counterstrike" data-tooltip="{{sm.defense.counterstrike.deltaLabel}}" data-tooltip-direction="UP">{{sm.defense.counterstrike.effective}}</div>
            {{else}}
            <div class="ledger__cell ledger__cell--dim"><i class="fa-solid fa-xmark fa-lg"></i></div>
            {{/unless}}
        </div>
        {{/each}}
        {{/each}}
    </div>
    {{/if}}

    {{!-- Missile Strike Modes: combat techniques + held missile weapons, same
         one-ledger-per-family / per-weapon-subheader pattern as Melee. --}}
    {{#if missileStrikeModes.length}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Being.Heading.missileStrikeModes"}}</span>
    </div>
    <div class="ledger" style="--ledger-cols: minmax(120px,1fr) 2.6rem 2.6rem 3rem 3rem 2.6rem">
        <div class="ledger__head">
            <div>{{localize "SOHL.Being.Column.mode"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.draw"}}">{{localize "SOHL.Being.Column.draw"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.baseRange"}}">{{localize "SOHL.Being.Column.baseRange"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.maxVolley"}}">{{localize "SOHL.Being.Column.maxVolley"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.StrikeMode.FIELDS.impactBase.label"}}">{{localize "SOHL.Being.Column.impact"}}</div>
            <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.attack"}}">{{localize "SOHL.Being.Column.attack"}}</div>
        </div>
        {{#each missileStrikeModes as |entry|}}
        <div class="section-legend section-legend--subtype">
            <span class="section-legend__name">{{entry.weapon.name}}</span>
        </div>
        {{#each entry.strikeModes as |sm|}}
        <div class="ledger__row" data-sm-id="{{sm.shortcode}}" data-item-id="{{entry.weapon.id}}">
            <div class="ledger__name" data-tooltip="{{sm.name}}">{{sm.name}}</div>
            <div class="ledger__cell" data-tooltip="{{sm.draw.deltaLabel}}" data-tooltip-direction="UP">{{sm.draw.effective}}</div>
            <div class="ledger__cell" data-tooltip="{{sm.baseRange.deltaLabel}}" data-tooltip-direction="UP">{{sm.baseRange.effective}}</div>
            <div class="ledger__cell">{{sm.maxVolleyMult}}</div>
            {{#unless sm.impact.disabled}}
            <div class="ledger__cell ledger__cell--rollable" data-action="rollStrikeModeImpact" data-tooltip="{{sm.impact.deltaLabel}}" data-tooltip-direction="UP">
                {{sm.impact.label}}
            </div>
            {{else}}
            <div class="ledger__cell ledger__cell--dim"><i class="fa-solid fa-xmark fa-lg"></i></div>
            {{/unless}}
            {{#unless sm.attack.disabled}}
            <div class="ledger__cell ledger__cell--rollable" data-action="rollStrikeModeTest" data-test-kind="attack" data-tooltip="{{sm.attack.deltaLabel}}" data-tooltip-direction="UP">{{sm.attack.effective}}</div>
            {{else}}
            <div class="ledger__cell ledger__cell--dim"><i class="fa-solid fa-xmark fa-lg"></i></div>
            {{/unless}}
        </div>
        {{/each}}
        {{/each}}
    </div>
    {{/if}}

    {{!-- Held Items — one dropdown per hold-capable limb --}}
    {{#if heldItemLimbs.length}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Being.Heading.heldItems"}}</span>
    </div>
    <div class="ledger held-items" style="--ledger-cols: minmax(120px,1fr) 14rem">
        <div class="ledger__head">
            <div>{{localize "SOHL.Being.Column.limb"}}</div>
            <div>{{localize "SOHL.Being.Column.itemHeld"}}</div>
        </div>
        {{#each heldItemLimbs as |limb|}}
        <div class="ledger__row" data-part-index="{{limb.index}}">
            <div class="ledger__name">{{limb.label}}</div>
            <div>
                <select class="held-item-select" data-part-index="{{limb.index}}">
                    <option value="">—</option>
                    {{#each @root.holdableItems as |it|}}
                    <option value="{{it.id}}" {{#if (eq it.id limb.heldItemId)}}selected{{/if}}>{{it.name}}</option>
                    {{/each}}
                </select>
            </div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if isGM}}
    {{!-- Default combat group: auto-assigns this actor's combatants on combat start --}}
        {{formGroup fields.defaultCombatGroup
            classes="text-field combat-default-group"
            placeholder=(localize "SOHL.Combat.defaultGroupName")
            localize=true
            stacked=false
            value=system.defaultCombatGroup}}
    {{/if}}

    {{!-- Body Locations: a FLAT, read-only reference table — armor totals
         (natural protection + worn armor), covering material, shock, and
         impairment per location, in anatomical (head-to-toe) order. Zone/part
         grouping, the hit-range chip, and all authoring chrome (add / drag /
         context-menu) live on the Profile tab's Body Structure editor now —
         Combat is armor-lookup reference only, so there is no rail here. --}}
    {{#if structure}}
    <div class="section-legend">
        <span class="section-legend__name">{{localize "SOHL.Being.Heading.BodyStructure"}}</span>
        <span class="section-legend__meta">{{localize "SOHL.Being.Heading.bodyStructureMeta"}}</span>
    </div>
    <div class="search-items">
        <input class="search-criteria" type="search" name="search-bodylocations" value=""
            aria-label="{{localize "SOHL.Being.Search.bodyLocations"}}" placeholder="{{localize "SOHL.Being.Search.bodyLocations"}}" autocomplete="off" />
    </div>
    <div class="bodylocations-list">
        <div class="ledger" style="--ledger-cols: minmax(130px,1fr) 3.2rem 2rem 2rem 2rem 2rem 2.4rem 2.4rem">
            <div class="ledger__head">
                <div>{{localize "SOHL.Being.Column.location"}}</div>
                <div class="ledger__head-num">{{localize "SOHL.Being.Column.material"}}</div>
                <div class="ledger__head-num" data-tooltip="{{localize "SOHL.ImpactModifier.ASPECT.blunt"}}">{{localize "SOHL.ImpactModifier.AspectAbbrev.blunt"}}</div>
                <div class="ledger__head-num" data-tooltip="{{localize "SOHL.ImpactModifier.ASPECT.edged"}}">{{localize "SOHL.ImpactModifier.AspectAbbrev.edged"}}</div>
                <div class="ledger__head-num" data-tooltip="{{localize "SOHL.ImpactModifier.ASPECT.piercing"}}">{{localize "SOHL.ImpactModifier.AspectAbbrev.piercing"}}</div>
                <div class="ledger__head-num" data-tooltip="{{localize "SOHL.ImpactModifier.ASPECT.fire"}}">{{localize "SOHL.ImpactModifier.AspectAbbrev.fire"}}</div>
                <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.shock"}}">{{localize "SOHL.Being.Column.shock"}}</div>
                <div class="ledger__head-num" data-tooltip="{{localize "SOHL.Being.ColTip.impairment"}}">{{localize "SOHL.Being.Column.impairment"}}</div>
            </div>
            {{#each bodyZones as |zone|}}
            {{#each zone.parts as |part|}}
            {{#each part.locations as |loc|}}
            <div class="ledger__row" data-search-name="{{loc.name}}">
                <div class="ledger__name">{{loc.name}}</div>
                <div class="ledger__cell ledger__cell--dim">{{loc.layers}}</div>
                <div class="ledger__cell">{{loc.blunt}}</div>
                <div class="ledger__cell">{{loc.edged}}</div>
                <div class="ledger__cell">{{loc.piercing}}</div>
                <div class="ledger__cell">{{loc.fire}}</div>
                <div class="ledger__cell">{{loc.shock}}</div>
                <div class="ledger__cell ledger__cell--dim">{{loc.impair}}</div>
            </div>
            {{/each}}
            {{/each}}
            {{/each}}
        </div>
    </div>
    {{/if}}
</section>
