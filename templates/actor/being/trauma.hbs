<section class="tab trauma{{#if tab.active}} active{{/if}}" data-group="{{tab.group}}" data-tab="trauma">
    {{!-- Injuries family: subtype-item pattern (§2.3a) — present-only SubType
    groups, per-subtype add, generic footer add. --}}
    <div class="section-legend">
        <span class="section-legend__name">Injuries</span>
        <span class="section-legend__rule"></span>
    </div>

    {{!-- Each sub-type renders only its own columns (#939); the column set +
    ledger grid come pre-built from being-sheet-view (TRAUMA_SUBTYPE_COLUMNS). --}}
    <div class="injuries-list">
        {{#each injurySections as |section|}}
            {{#if section.injuries.length}}
            <div class="section-legend section-legend--subtype">
                <span class="section-legend__name">{{section.label}}</span>
                <span class="section-legend__meta">{{section.injuries.length}}</span>
                <span class="section-legend__rule"></span>
                <span class="section-legend__add">
                    <a class="add-button add-button--small item-create" data-action="createItem"
                        data-type="trauma" data-sub-type="{{section.subType}}"
                        data-tooltip="Add {{section.label}} Trauma">
                        <i class="fa-solid fa-plus"></i><span>Add {{section.label}} Trauma</span>
                    </a>
                </span>
            </div>
            <div class="ledger" style="--ledger-cols:{{section.ledgerCols}}">
                <div class="ledger__head">
                    <div></div>
                    <div></div>
                    <div>{{localize "SOHL.Trauma.COLUMN.name"}}</div>
                    {{#each section.columns as |col|}}
                    <div class="{{col.headClass}}"{{#if col.tooltipKey}} data-tooltip="{{localize col.tooltipKey}}"{{/if}}>{{localize col.labelKey}}</div>
                    {{/each}}
                    <div></div>
                </div>
                {{#each section.injuries as |injury|}}
                <div class="ledger__row item" data-search-name="{{injury.name}}" data-item-id="{{injury.id}}" data-item-name="{{injury.name}}">
                    <div class="ledger__grip"><i class="fa-solid fa-grip-vertical"></i></div>
                    <div class="ledger__icon default-action"><img src="{{injury.img}}" alt="" /></div>
                    <div class="ledger__name default-action" data-tooltip="{{injury.name}}">{{injury.name}}</div>
                    {{#each section.columns as |col|}}
                        {{#if (eq col.kind "severity")}}
                        <div class="ledger__cell" data-tooltip="{{injury.severityDeltaLabel}}" data-tooltip-direction="UP">
                            {{#if injury.healed}}
                            <i class="ledger__heal fa-solid fa-heart-circle-plus" data-tooltip="Healed"></i>
                            {{else}}
                            {{injury.severity}}
                            {{/if}}
                        </div>
                        {{else if (eq col.kind "hr")}}
                        <div class="ledger__cell{{#if injury.healingRateDisabled}} ledger__cell--dim{{/if}}"
                            data-tooltip="{{injury.healingRateDeltaLabel}}" data-tooltip-direction="UP">
                            {{#if injury.healingRateDisabled}}
                            <i class="fa-solid fa-xmark fa-lg"></i>
                            {{else}}
                            {{#unless injury.isTreated}}NT{{/unless}}{{injury.healingRate}}
                            {{/if}}
                        </div>
                        {{else if (eq col.kind "level")}}
                        <div class="ledger__cell" data-tooltip="{{injury.severityDeltaLabel}}" data-tooltip-direction="UP">{{injury.level}}</div>
                        {{else if (eq col.kind "category")}}
                        <div class="ledger__cell ledger__cell--text">{{injury.categoryDisplay}}</div>
                        {{else if (eq col.kind "area")}}
                        <div class="ledger__cell ledger__cell--text">{{injury.area}}</div>
                        {{else if (eq col.kind "nextTest")}}
                        <div class="ledger__cell ledger__cell--text">{{injury.nextTest}}</div>
                        {{else}}
                        <div class="ledger__notes" data-tooltip="{{injury.notes}}">{{injury.notes}}</div>
                        {{/if}}
                    {{/each}}
                    <div class="ledger__controls">
                        <a class="icon-button item-contextmenu" title="Menu"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
        {{/each}}
    </div>
    <div class="add-footer">
        <a class="add-button item-create" data-action="createItem" data-type="trauma" data-tooltip="Add Trauma">
            <i class="fa-solid fa-plus"></i><span>Add Trauma</span>
        </a>
    </div>

    {{!-- Afflictions family: subtype-item pattern (§2.3a) — already grouped
    present-only by _prepareTraumaContext (buildAfflictionGroups); the SubType
    column is dropped in favor of the SubType header + per-subtype add. --}}
    <div class="section-legend">
        <span class="section-legend__name">Afflictions</span>
        <span class="section-legend__rule"></span>
    </div>

    <div class="afflictions-list">
        {{#each afflictionGroups as |group|}}
            {{#if group.afflictions.length}}
            <div class="section-legend section-legend--subtype">
                <span class="section-legend__name">{{group.label}}</span>
                <span class="section-legend__meta">{{group.afflictions.length}}</span>
                <span class="section-legend__rule"></span>
                <span class="section-legend__add">
                    <a class="add-button add-button--small item-create" data-action="createItem"
                        data-type="affliction" data-sub-type="{{group.subType}}"
                        data-tooltip="Add {{group.label}} Affliction">
                        <i class="fa-solid fa-plus"></i><span>Add {{group.label}} Affliction</span>
                    </a>
                </span>
            </div>
            <div class="ledger" style="--ledger-cols:1.2rem 1.5rem minmax(140px,1.4fr) 4rem 2.6rem 5.5rem 1fr 1.6rem">
                <div class="ledger__head">
                    <div></div>
                    <div></div>
                    <div>Affliction</div>
                    <div class="ledger__head-num">Level</div>
                    <div class="ledger__head-num" data-tooltip="Healing Rate">HR</div>
                    <div>Source</div>
                    <div>Notes</div>
                    <div></div>
                </div>
                {{#each group.afflictions as |aff|}}
                <div class="ledger__row item" data-search-name="{{aff.name}}" data-item-id="{{aff.id}}" data-item-name="{{aff.name}}">
                    <div class="ledger__grip"><i class="fa-solid fa-grip-vertical"></i></div>
                    <div class="ledger__icon default-action"><img src="{{aff.img}}" alt="" /></div>
                    <div class="ledger__name default-action" data-tooltip="{{aff.name}}">{{aff.name}}</div>
                    <div class="ledger__cell" data-tooltip="{{aff.levelDeltaLabel}}" data-tooltip-direction="UP">{{aff.level}}</div>
                    <div class="ledger__cell{{#if aff.healingRateDisabled}} ledger__cell--dim{{/if}}"
                        data-tooltip="{{aff.healingRateDeltaLabel}}" data-tooltip-direction="UP">
                        {{#if aff.healingRateDisabled}}
                        <i class="fa-solid fa-xmark fa-lg"></i>
                        {{else}}
                        {{aff.healingRate}}
                        {{/if}}
                    </div>
                    <div class="ledger__cell ledger__cell--text">{{aff.source}}</div>
                    <div class="ledger__notes" data-tooltip="{{aff.notes}}">{{aff.notes}}</div>
                    <div class="ledger__controls">
                        <a class="icon-button item-contextmenu" title="Menu"><i class="fa-solid fa-ellipsis-vertical fa-fw"></i></a>
                    </div>
                </div>
                {{/each}}
            </div>
            {{/if}}
        {{/each}}
    </div>
    <div class="add-footer">
        <a class="add-button item-create" data-action="createItem" data-type="affliction" data-tooltip="{{localize 'SOHL.Affliction.Heading.Add.label'}}">
            <i class="fa-solid fa-plus"></i><span>{{localize "SOHL.Affliction.Heading.Add.label"}}</span>
        </a>
    </div>
</section>
