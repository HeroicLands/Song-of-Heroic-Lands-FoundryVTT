{{#if isMiss}}
<div class="sohl chat-card item-card" data-actor-id="{{actorId}}">
    <header class="card-header">
        <h3 class="title">{{localize "SOHL.Chat.Injury.missed"}}</h3>
        <h4 class="subtitle">{{name}}</h4>
    </header>

    <div class="card-content center">
        <div class="flexrow">
            <span class="label">{{localize "SOHL.Chat.Injury.hitLocationRoll"}}:</span>
            <span class="value"
                >{{localize "SOHL.Chat.Injury.zoneRoll"
                targetZoneNumber=targetZoneNumber zoneDieLabel=zoneDieLabel
                zoneDieResult=zoneDieResult hitZoneNumber=hitZoneNumber
                zoneName=(localize "SOHL.Chat.Injury.missed")}}</span
            >
        </div>
    </div>

    <div class="card-content center">
        <span class="note success-text"
            >{{localize "SOHL.Chat.Injury.noTarget"}}</span
        >
    </div>
</div>
{{else}}
<div class="sohl chat-card item-card" data-actor-id="{{actorId}}">
    <header class="card-header">
        <h3 class="title">{{localize "SOHL.Chat.Injury.title" zone=bodyZoneName}}</h3>
        <h4 class="subtitle">{{name}}</h4>
    </header>

    {{!-- Zone: the Zone-Number + Zone-Die aim trace ending in the zone name
    when the location was derived, else just the zone name. --}}
    <div class="card-content center">
        <div class="flexrow">
            <span class="label">{{localize "SOHL.Chat.Injury.zone"}}:</span>
            {{#if locationDerived}}
            <span class="value"
                >{{localize "SOHL.Chat.Injury.zoneRoll"
                targetZoneNumber=targetZoneNumber zoneDieLabel=zoneDieLabel
                zoneDieResult=zoneDieResult hitZoneNumber=hitZoneNumber
                zoneName=zoneName}}</span
            >
            {{else}}
            <span class="value">{{zoneName}}</span>
            {{/if}}
        </div>
    </div>

    {{#if locationOverridden}}
    <div class="card-content center">
        <span class="note failure-text">{{localize "SOHL.Chat.Injury.locationOverridden"}}</span>
    </div>
    {{/if}}

    {{!-- Location: the struck hit-location's name. The Body Part is intentionally
    not shown — it is inferable from the location. --}}
    <div class="card-content center">
        <div class="flexrow">
            <span class="label">{{localize "SOHL.Chat.Injury.location"}}:</span>
            <span class="value">{{locationName}}</span>
        </div>
    </div>

    <div class="card-content center">
        <div class="flexrow">
            <span class="label">{{localize "SOHL.ImpactModifier.Aspect.label"}}:</span>
            <span class="value">{{#if aspect}}{{localize (concat "SOHL.ImpactModifier.Aspect." aspect)}}{{/if}}</span>
        </div>
    </div>

    {{#if armorReduction}}
    <div class="card-content center">
        <div class="flexrow">
            <span class="label">{{localize "SOHL.Chat.Injury.armorReduction"}}:</span>
            <span class="value">{{armorReduction}}</span>
            <span class="note"
                >{{localize "SOHL.Chat.Injury.armorReductionNote"}}</span
            >
        </div>
    </div>
    {{/if}}

    <div class="card-content center">
        <div class="flexrow">
            <span class="label">{{localize "SOHL.Chat.Injury.armorLayers"}}:</span>
            <span class="value">{{#if armorType}}{{armorType}}{{else}}{{localize "SOHL.Chat.Injury.none"}}{{/if}} ({{armorValue}})</span>
        </div>
    </div>

    {{!-- Summary: Impact (Imp), Injury Level (IL), Shock Index (Shk) as three
    inline label:value cells on a single row. --}}
    <div class="card-content center">
        <div class="flexrow injury-summary">
            <span class="summary-cell">
                <span class="label">{{localize "SOHL.Chat.Injury.impact"}}:</span>
                <span class="value"><strong>{{impactVal}}</strong></span>
            </span>
            <span class="summary-cell">
                <span class="label">{{localize "SOHL.Chat.Injury.injuryLevel"}}:</span>
                {{#if isInjured}}
                <span class="value failure-text">{{injuryLevelText}}</span>
                {{else}}
                <span class="value success-text">{{localize "SOHL.Chat.Injury.noInjury"}}</span>
                {{/if}}
            </span>
            <span class="summary-cell">
                <span class="label">{{localize "SOHL.Chat.Injury.shockIndex"}}:</span>
                <span class="value">{{shockIndex}}</span>
            </span>
        </div>
    </div>

    {{#if isGlancingBlow}}
    <div class="card-content center">
        <div class="flexrow">
            <span class="note success-test"
                >{{localize "SOHL.Chat.Injury.glancingBlow"}}</span
            >
        </div>
    </div>
    {{/if}}

    {{#if needsShockRoll}}
    <div class="card-content center">
        <div class="flexrow">
            <span class="note failure-text">{{localize "SOHL.Chat.Injury.makeShockRoll"}}</span>
        </div>
        {{#if shockRollBonus}}
        <div class="flexrow">
            <span class="note">{{#if (gt shockRollBonus 0)}}+{{/if}}{{shockRollBonus}} {{localize "SOHL.Chat.Injury.shockRollModifier"}}</span>
        </div>
        {{/if}}
    </div>
    {{else}}
    <div class="card-content center">
        <div class="flexrow">
            <span class="note">{{localize "SOHL.Chat.Injury.shockNotNeeded"}}</span>
        </div>
    </div>
    {{/if}}

    {{#if isBleeder}}
    <div class="card-content center">
        <span class="note failure-text">{{localize "SOHL.Chat.Injury.bleederNote"}}</span>
    </div>
    {{/if}}

    {{#unless (eq fumble "none")}}
    <div class="card-content center">
        {{#if (eq fumble "auto")}}
        <span class="note failure-text">{{localize "SOHL.Chat.Injury.fumbleAuto"}}</span>
        {{else}}
        <span class="note failure-text">{{localize "SOHL.Chat.Injury.fumbleRoll"}}</span>
        {{/if}}
    </div>
    {{/unless}}

    {{#unless (eq stumble "none")}}
    <div class="card-content center">
        {{#if (eq stumble "auto")}}
        <span class="note failure-text">{{localize "SOHL.Chat.Injury.stumbleAuto"}}</span>
        {{else}}
        <span class="note failure-text">{{localize "SOHL.Chat.Injury.stumbleRoll"}}</span>
        {{/if}}
    </div>
    {{/unless}}

    {{#if amputationTested}}
    <div class="card-content center">
        {{#if amputationSevered}}
        <span class="note failure-text"
            >{{localize "SOHL.Chat.Injury.severed" zone=bodyZoneName}}{{#if amputationDied}}<br
            />{{localize "SOHL.Chat.Injury.victimSlain"}}{{/if}}</span
        >
        {{else}}
        <span class="note success-text"
            >{{localize "SOHL.Chat.Injury.amputationResisted" zone=bodyZoneName}}</span
        >
        {{/if}}
    </div>
    {{else if canAmputate}}
    <div class="card-content center">
        <span class="note failure-text"
            >{{localize "SOHL.Chat.Injury.amputationApplies"}}{{#if amputationModifier}}
            {{localize "SOHL.Chat.Injury.amputationModifier" modifier=amputationModifier}}{{/if}}{{localize "SOHL.Chat.Injury.amputationUnrolled"}}</span
        >
    </div>
    {{/if}}

    {{#if treatmentModifier}}
    <div class="card-content center">
        <span class="note">{{localize "SOHL.Chat.Injury.treatmentModifier" modifier=treatmentModifier}}</span>
    </div>
    {{/if}}

    {{#if addToCharSheet}}
    <div class="card-content center">
        <span>{{localize "SOHL.Chat.Injury.recorded"}}</span>
    </div>
    {{/if}}

    <div class="card-buttons">
        {{#if needsShockRoll}}
        <button
            data-action="injuryShock"
            data-handler-uuid="{{handlerActorUuid}}"
            data-scope="{{toJSON shockScope}}">
            {{localize "SOHL.Chat.Injury.shockRollButton"}}
        </button>
        {{/if}}
    </div>
</div>
{{/if}}
