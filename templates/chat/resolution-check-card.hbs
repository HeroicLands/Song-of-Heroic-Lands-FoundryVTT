{{!--
Resolution Check card body — the *Check half of the resolution phase. It OFFERS
to settle the affliction's outcome; nothing is applied until someone presses the
appended [Set Resolution] button (added by buildActionCard). Body only.
--}}
<div class="sohl chat-card">
    <header class="card-header flexrow">
        <h3 class="title">{{localize "SOHL.Chat.ResolutionCheck.title"}}</h3>
    </header>

    <div class="card-content center">
        <span>{{localize "SOHL.Chat.ResolutionCheck.due" patient=patientName affliction=afflictionName}}</span>
    </div>

    <div class="card-content center">
        <span class="label">{{localize "SOHL.Affliction.FIELDS.healingRateBase.label"}}:</span>
        <span class="value">{{healingRate}}</span>
    </div>
</div>
