<div class="sohl chat-card item-card" data-actor-id="{{actorId}}">
    <header class="card-header flexrow">
        <h3 class="title">{{localize "SOHL.Chat.Rally.title"}}</h3>
    </header>

    <div class="card-content center">
        <span>{{localize "SOHL.Chat.Rally.prompt" name=rallierName}}</span>
    </div>

    <div class="card-content center">
        {{#if steady}}
        <span>{{localize "SOHL.Chat.Rally.eligible"}}</span>
        {{else}}
        <span
            >{{localize "SOHL.Chat.Rally.reactionTest"}}</span
        >
        {{/if}}
    </div>
</div>
