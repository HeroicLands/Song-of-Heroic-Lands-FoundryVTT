{{!--
Skill Development Roll card (#1103). Posted after `improveWithSDR` resolves on a
Skill or a Mystical Ability. It shows the two numbers the roll turns on — the
SDR total (`1d100` + Skill Base) and the base mastery level it had to beat —
followed by whether the item improved.

Deliberately *not* `standard-test-card.hbs`: an SDR is not a success test. It
has no mastery-level modifier to display, no Fate to spend, no success level, and
nothing for the GM result-edit pencil to re-evaluate — so this card carries none
of them.
--}}
<div class="sohl chat-card item-card" data-actor-uuid="{{actorUuid}}">
    <header class="card-header">
        <h3 class="title">{{title}}</h3>
    </header>

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.Sdr.target"}}</span>
        <span class="value">{{target}}</span>
    </div>

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.Sdr.roll"}}</span>
        <span class="value {{#if isSuccess}}success-text{{else}}failure-text{{/if}}">{{rollTotal}}</span>
    </div>

    {{#if resultText}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.Sdr.result"}}</span>
        <span class="value {{#if isSuccess}}success-text{{else}}failure-text{{/if}}">{{resultText}}</span>
    </div>

    {{#if resultDesc}}
    <div class="card-content">
        <span class="value">{{resultDesc}}</span>
    </div>
    {{/if}}
    {{/if}}

    <footer class="card-footer {{#if isSuccess}}success-text{{else}}failure-text{{/if}}">
        <span>{{description}}</span>
    </footer>
</div>
