<div class="sohl chat-card item-card" data-actor-id="{{actorId}}">
    <header class="card-header flexcol">
        <h3 class="title">{{title}}</h3>
        <h4 class="subtitle">{{localize "SOHL.Chat.Attack.subtitle" attacker=attacker defender=defender}}</h4>
    </header>

    <div class="card-content">
        <span class="label center">{{localize "SOHL.Chat.Attack.attacker"}}</span>
        <div class="card-content">
            <div class="adjustment">
                <div class="flexrow">
                    <span class="label adj-name">{{localize "SOHL.Chat.Attack.adjustment"}}</span>
                    <span class="label adj-value">{{localize "SOHL.Chat.Attack.value"}}</span>
                </div>
                {{#each attackMods}}
                <div class="flexrow">
                    <span class="adj-name">{{this.name}}</span>
                    <span class="adj-value"
                        >{{#if (gt this.value 0)}}+{{/if}}{{this.value}}</span
                    >
                </div>
                {{/each}}
            </div>
        </div>
    </div>

    {{#if defendMods.length}}
    <div class="card-content">
        <span class="label center">{{localize "SOHL.Chat.Attack.defender"}}</span>
        <div class="card-content">
            <div class="adjustment">
                <div class="flexrow">
                    <span class="label adj-name">{{localize "SOHL.Chat.Attack.adjustment"}}</span>
                    <span class="label adj-value">{{localize "SOHL.Chat.Attack.value"}}</span>
                </div>
                {{#each defendMods}}
                <div class="flexrow">
                    <span class="adj-name">{{this.name}}</span>
                    <span class="adj-value"
                        >{{#if (gt this.value 0)}}+{{/if}}{{this.value}}</span
                    >
                </div>
                {{/each}}
            </div>
        </div>
    </div>
    {{/if}}

    <div class="grid grid-2col mingap">
        <span class="header">{{localize "SOHL.Chat.Attack.attack"}}</span>
        <span class="header">{{localize "SOHL.Chat.Attack.defend"}}</span>
        <span class="center">{{attackWeapon}}</span>
        <span class="center"
            >{{#if defense}}{{defense}}{{else}}&#8212;{{/if}}</span
        >
        <span class="center">{{localize "SOHL.Chat.Attack.effAML" value=effAML}}</span>
        <span class="center"
            >{{#if effDML}}{{localize "SOHL.Chat.Attack.effDML" value=effDML}}{{else}}&#8212;{{/if}}</span
        >
        <span class="center">{{localize "SOHL.Chat.Attack.roll" value=attackRoll}}</span>
        <span class="center"
            >{{#if defenseRoll}}{{localize "SOHL.Chat.Attack.roll" value=defenseRoll}}{{else}}&#8212;{{/if}}</span
        >
        {{#if atkIsSuccess}}
        <span
            class="center {{#if atkIsCritical}}critical-success-block{{else}}success-text{{/if}}"
            >{{atkRollResult}}</span
        >
        {{else}}
        <span
            class="center {{#if atkIsCritical}}critical-failure-block{{else}}failure-text{{/if}}"
            >{{atkRollResult}}</span
        >
        {{/if}} {{#if defenseRoll}} {{#if defIsSuccess}}
        <span
            class="center {{#if defIsCritical}}critical-success-block{{else}}success-text{{/if}}"
            >{{defRollResult}}</span
        >
        {{else}}
        <span
            class="center {{#if defIsCritical}}critical-failure-block{{else}}failure-text{{/if}}"
            >{{defRollResult}}</span
        >
        {{/if}} {{else}}
        <span class="center">&#8212;</span>
        {{/if}}
    </div>

    <div class="card-content center">
        <span class="label">{{localize "SOHL.OpposedTestResult.toChat.victoryStars"}}:</span>
        <span class="value"
            >{{#if vsStars}}<span class="victory-stars" aria-label="{{vsCount}} {{localize "SOHL.OpposedTestResult.toChat.victoryStars"}}">{{#each vsStars}}<i class="{{#if this}}fa-solid{{else}}fa-regular{{/if}} fa-star" aria-hidden="true"></i>{{/each}}</span>{{else}}<strong>{{localize "SOHL.Common.none"}}</strong>{{/if}}</span
        >
    </div>

    <div class="card-content center">
        <span class="result-desc">{{resultDesc}}</span>
    </div>

    {{#if numAtkTA}}
    <div class="card-content center">
        <span class="label">{{localize "SOHL.Chat.Attack.attackerTAs"}}</span>
        <span class="value">{{numAtkTA}}</span>
    </div>
    {{/if}} {{#if numDefTA}}
    <div class="card-content center">
        <span class="label">{{localize "SOHL.Chat.Attack.defenderTAs"}}</span>
        <span class="value">{{numDefTA}}</span>
    </div>
    {{/if}} {{#if atkWeaponBroke}}
    <div class="card-content center">
        <span class="weapon-broke">{{localize "SOHL.Chat.Attack.weaponBroke" name=attacker weapon=attackWeapon}}</span>
    </div>
    {{/if}} {{#if defWeaponBroke}}
    <div class="card-content center">
        <span class="weapon-broke">{{localize "SOHL.Chat.Attack.weaponBroke" name=defender weapon=defendWeapon}}</span>
    </div>
    {{/if}} {{#if hasAttackHit}}
    <div class="card-content center">
        <span class="label">{{localize "SOHL.Chat.Attack.attackImpact"}}</span>
        <span class="value"><strong>{{impactFormula}}</strong></span>
    </div>
    {{/if}} {{#if isAtkFumbleTest}}
    <div class="card-content center">
        <span class="value failure-text"
            >{{localize "SOHL.Chat.Attack.fumbleTest" name=attacker}}</span
        >
    </div>
    {{/if}} {{#if isDefFumbleTest}}
    <div class="card-content center">
        <span class="value failure-text"
            >{{localize "SOHL.Chat.Attack.fumbleTest" name=defender}}</span
        >
    </div>
    {{/if}} {{#if isAtkStumbleTest}}
    <div class="card-content center">
        <span class="value failure-text"
            >{{localize "SOHL.Chat.Attack.stumbleTest" name=attacker}}</span
        >
    </div>
    {{/if}} {{#if isDefStumbleTest}}
    <div class="card-content center">
        <span class="value failure-text"
            >{{localize "SOHL.Chat.Attack.stumbleTest" name=defender}}</span
        >
    </div>
    {{/if}} {{#if (or hasAttackInjury hasDefendInjury)}}
    {{!--
        Injury buttons route to the target actor's `resolveInjury` handler, which
        opens the Resolve Injury dialog from the forwarded { impact, aspect }.
        (Stumble/Fumble/Tactical-Advantage follow-up buttons are deferred to a
        later slice; the card still surfaces those as text above.)
    --}}
    <div class="card-buttons">
        {{#if hasAttackInjury}}
        <button
            id="attacker-injury"
            data-action="resolveInjury"
            data-handler-uuid="{{attackInjuryHandlerUuid}}"
            data-scope="{{toJSON attackInjuryScope}}">
            {{localize "SOHL.Chat.Attack.calculateInjury" name=attackInjuryTargetName}}
        </button>
        {{/if}} {{#if hasDefendInjury}}
        <button
            id="defender-injury"
            data-action="resolveInjury"
            data-handler-uuid="{{defendInjuryHandlerUuid}}"
            data-scope="{{toJSON defendInjuryScope}}">
            {{localize "SOHL.Chat.Attack.calculateInjury" name=defendInjuryTargetName}}
        </button>
        {{/if}}
    </div>
    {{/if}}
</div>
