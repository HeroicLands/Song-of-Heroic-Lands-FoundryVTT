{{!--
Course Test result card body. Reports the affliction's new Healing Rate, the
host's reaction to it, and — crucially — whether that reaction was applied to
the character sheet, since the player may have declined it. Body only.
--}}
<div class="sohl chat-card">
    <header class="card-header flexrow">
        <h3 class="title">{{localize "SOHL.Chat.CourseResult.title"}}</h3>
    </header>

    <div class="card-content center">
        <span>{{localize "SOHL.Chat.CourseResult.outcome" patient=patientName affliction=afflictionName hr=healingRate}}</span>
    </div>

    <div class="card-content center">
        {{#if defeated}}
            <span class="value">{{localize "SOHL.Chat.CourseResult.defeated"}}</span>
        {{else}}
            {{#if fatigueLevels}}
                <span class="value">{{localize "SOHL.Chat.CourseResult.fatigue" levels=fatigueLevels}}</span>
            {{/if}}
            {{#if shockLabel}}
                <span class="value">{{localize shockLabel}}</span>
            {{/if}}
        {{/if}}
    </div>

    <div class="card-content center">
        <span class="hint">
            {{#if applied}}
                {{localize "SOHL.Chat.CourseResult.applied"}}
            {{else}}
                {{localize "SOHL.Chat.CourseResult.notApplied"}}
            {{/if}}
        </span>
    </div>
</div>
