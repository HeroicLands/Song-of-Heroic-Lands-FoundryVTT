{{!--
Fate result card (#854). Posted after a Fate test resolves. It shows the Fate
roll and — crucially — the *resolved path* text (which rung matched, and for a
critical success which branch the player chose), plus the Fate Mystery a point
was spent from. The original test's own card is re-posted separately with the
bumped success level.
--}}
<div class="sohl chat-card item-card" data-actor-uuid="{{actorUuid}}">
    <header class="card-header">
        <h3 class="title">{{title}}</h3>
    </header>

    {{#if mlModHtml}}
    <div class="card-content">
        {{{mlModHtml}}}
    </div>
    {{/if}}

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.FateRoll.target"}}</span>
        <span class="value">{{target}}</span>
    </div>

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.FateRoll.roll"}}</span>
        <span class="value {{#if isSuccess}}success-text{{else}}failure-text{{/if}}">{{rollTotal}}</span>
    </div>

    {{#if outcomeLabel}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.FateRoll.result"}}</span>
        <span class="value {{#if isSuccess}}success-text{{else}}failure-text{{/if}}">{{outcomeLabel}}</span>
    </div>
    {{/if}}

    <footer class="card-footer {{#if isSuccess}}{{#if isCritical}}critical-success-block{{else}}success-text{{/if}}{{else}}{{#if isCritical}}critical-failure-block{{else}}failure-text{{/if}}{{/if}}">
        <span>{{pathText}}{{#if sourceText}} {{sourceText}}{{/if}}</span>
    </footer>
</div>
