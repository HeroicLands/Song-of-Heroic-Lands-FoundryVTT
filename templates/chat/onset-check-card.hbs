{{!--
Onset Check card body — the *Check half of the onset phase. It OFFERS to set the
affliction's onset and nothing more; the incubation has run its course, but
whether the affliction is now symptomatic is the table's call. The appended
[Set Onset] button (added by buildActionCard) performs it. Body only.
--}}
<div class="sohl chat-card">
    <header class="card-header flexrow">
        <h3 class="title">{{localize "SOHL.Chat.OnsetCheck.title"}}</h3>
    </header>

    <div class="card-content center">
        <span>{{localize "SOHL.Chat.OnsetCheck.due" patient=patientName affliction=afflictionName}}</span>
    </div>

    <div class="card-content center">
        <span class="label">{{localize "SOHL.Affliction.FIELDS.subType.label"}}:</span>
        <span class="value">{{#if subType}}{{localize (concat "SOHL.Affliction.SubType." subType)}}{{/if}}</span>
    </div>
</div>
