{{!--
Affliction Treatment result card body (spoken by the physician). Reports the
Success Stars earned, which the appended owner-gated [Accept Treatment] button
relays to the patient's affliction as its Course Bonus. Body only — no buttons
here; nothing is applied until the patient accepts.
--}}
<div class="sohl chat-card">
    <header class="card-header flexrow">
        <h3 class="title">{{localize "SOHL.Chat.AfflictionTreatmentResult.title"}}</h3>
    </header>

    <div class="card-content center">
        <span>{{localize "SOHL.Chat.AfflictionTreatmentResult.result" physician=physicianName stars=successStars}}</span>
    </div>

    <div class="card-content center">
        <span class="hint">{{localize "SOHL.Chat.AfflictionTreatmentResult.hint"}}</span>
    </div>
</div>
