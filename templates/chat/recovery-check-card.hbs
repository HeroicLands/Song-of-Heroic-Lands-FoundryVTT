{{!--
Generic recovery *Check card body — the offer half of a recurring cycle. It
names the effect that has come due and OFFERS its test; no roll has been made
and the character is unchanged. The appended button (added by buildActionCard)
runs the single test. Body only — no buttons here.
--}}
<div class="sohl chat-card">
    <header class="card-header flexrow">
        <h3 class="title">{{effect}}</h3>
    </header>

    <div class="card-content center">
        <span>{{localize "SOHL.Chat.RecoveryCheck.due" patient=patientName trauma=traumaName effect=effect}}</span>
    </div>

    <div class="card-content center">
        <span class="label">{{localize "SOHL.Chat.Common.severity"}}:</span>
        <span class="value">{{level}}</span>
    </div>
</div>
