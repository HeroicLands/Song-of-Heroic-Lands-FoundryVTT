<div class="sohl chat-card item-card" data-actor-id="{{actorId}}">
    <header class="card-header flexrow">
        <h3 class="title">{{title}}</h3>
    </header>

    {{#if notes}}
    <div class="card-note">
        <span>{{notes}}</span>
    </div>
    {{/if}}

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.MissileDamage.numDamageDice"}}:</span>
        <span class="value">{{damageDice}}</span>
    </div>

    <div class="card-content">
        <span class="label">{{localize "SOHL.ImpactModifier.Aspect.label"}}:</span>
        <span class="value">{{#if aspect}}{{localize (concat "SOHL.ImpactModifier.Aspect." aspect)}}{{/if}}</span>
    </div>

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.MissileDamage.rangeImpact"}}:</span>
        <span class="value">{{range}} ({{rangeImpact}})</span>
    </div>

    {{#if (ne addlImpact 0)}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.MissileDamage.additionalDamage"}}:</span>
        <span class="value">{{addlImpact}}</span>
    </div>

    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.MissileDamage.impactRangeAddlRoll"}}:</span>
        <span class="value"
            >{{rangeImpact}} + {{addlImpact}} + {{rollValue}} =
            <strong>{{totalImpact}}</strong></span
        >
    </div>
    {{else}}
    <div class="card-content">
        <span class="label">{{localize "SOHL.Chat.MissileDamage.impactRangeRoll"}}:</span>
        <span class="value"
            >{{rangeImpact}} + {{rollValue}} =
            <strong>{{totalImpact}}</strong></span
        >
    </div>
    {{/if}}
</div>
