<div class="sohl chat-card item-card">
    <header class="card-header flexrow">
        <h3 class="title">{{localize "SOHL.Chat.FacePall.title"}}</h3>
    </header>

    {{#if actorName}}
    <div class="card-content center">
        <span>{{localize "SOHL.Chat.FacePall.prompt" name=actorName}}</span>
    </div>
    {{/if}}

    <div class="card-content">
        <span
            >{{localize "SOHL.Chat.FacePall.choices"}}</span
        >
    </div>

    <ul>
        <li>
            <strong>{{localize "SOHL.Chat.FacePall.embrace"}}</strong> {{localize "SOHL.Chat.FacePall.embraceDesc"}}
        </li>
        <li>
            <strong>{{localize "SOHL.Chat.FacePall.vacate"}}</strong> {{localize "SOHL.Chat.FacePall.vacateDesc"}}
        </li>
        <li>
            <strong>{{localize "SOHL.Chat.FacePall.trueDeath"}}</strong> {{localize "SOHL.Chat.FacePall.trueDeathDesc"}}
        </li>
    </ul>
</div>
